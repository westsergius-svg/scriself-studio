<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ScriSelfStudio.App</RootNamespace>
    <AssemblyName>ScriSelfStudio</AssemblyName>
    <IsUiProject>true</IsUiProject>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <!-- Значок exe: из него Windows берёт значок ярлыков, списка задач и ассоциации .scri. -->
    <ApplicationIcon>Assets\scriself.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Значок окна: Avalonia читает PNG, ICO она не декодирует. -->
    <AvaloniaResource Include="Assets\scriself.png" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\ScriSelfStudio.Persistence\Language\Data\wiki-synonyms.json.gz" Link="Documentation\Data\wiki-synonyms.json.gz" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\USER-GUIDE.md" Link="Documentation\Руководство.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\training\ScriSelfStudio-Training.pptx" Link="Documentation\Обучение.pptx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="AvaloniaMcp.Diagnostics" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ScriSelfStudio.Core\ScriSelfStudio.Core.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.Contracts\ScriSelfStudio.Contracts.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.Persistence\ScriSelfStudio.Persistence.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.BookArchitecture\ScriSelfStudio.BookArchitecture.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.EditorEngine\ScriSelfStudio.EditorEngine.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.Presentation\ScriSelfStudio.Presentation.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.Launcher\ScriSelfStudio.Launcher.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.EditorUI\ScriSelfStudio.EditorUI.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.ArchitectureUI\ScriSelfStudio.ArchitectureUI.csproj" />
    <ProjectReference Include="..\ScriSelfStudio.StoryUI\ScriSelfStudio.StoryUI.csproj" />
  </ItemGroup>
  <Import Project="..\..\installer\GrammarRuntime.targets" />
</Project>
