<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:arch="clr-namespace:ScriSelfStudio.ArchitectureUI;assembly=ScriSelfStudio.ArchitectureUI"
             xmlns:editor="clr-namespace:ScriSelfStudio.EditorUI;assembly=ScriSelfStudio.EditorUI"
             xmlns:launcher="clr-namespace:ScriSelfStudio.Launcher;assembly=ScriSelfStudio.Launcher"
             xmlns:story="clr-namespace:ScriSelfStudio.StoryUI;assembly=ScriSelfStudio.StoryUI"
             xmlns:export="clr-namespace:ScriSelfStudio.Presentation.Export;assembly=ScriSelfStudio.Presentation"
             xmlns:shell="clr-namespace:ScriSelfStudio.App.Shell"
             xmlns:views="clr-namespace:ScriSelfStudio.App.Views"
             x:Class="ScriSelfStudio.App.App"
             Name="ScriSelf Studio"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ScriSelfStudio.Presentation/Styles/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#3B8AE5" />
        <ColorPaletteResources x:Key="Dark" Accent="#3B8AE5" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://ScriSelfStudio.Presentation/Styles/AppStyles.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="launcher:LauncherViewModel">
      <launcher:LauncherView />
    </DataTemplate>
    <DataTemplate DataType="arch:ArchitectureViewModel">
      <arch:ArchitectureView />
    </DataTemplate>
    <DataTemplate DataType="shell:ArchitectureHostViewModel">
      <views:ArchitectureHostView />
    </DataTemplate>
    <DataTemplate DataType="editor:EditorViewModel">
      <editor:EditorView />
    </DataTemplate>
    <DataTemplate DataType="launcher:SettingsViewModel">
      <launcher:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="story:CharactersViewModel">
      <story:CharactersView />
    </DataTemplate>
    <DataTemplate DataType="story:TimelineViewModel">
      <story:TimelineView />
    </DataTemplate>
    <DataTemplate DataType="export:ExportViewModel">
      <views:ExportView />
    </DataTemplate>

    <DataTemplate DataType="shell:BookTreeViewModel">
      <Border Classes="projectTreeSurface" Padding="8,10">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="8,2,6,12">
            <TextBlock Text="{loc:Tr 'Проект'}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" />
            <Button x:Name="CollapseProjectTree" Grid.Column="1" Classes="treeCollapse"
                    Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).ToggleBookTreeCommand}"
                    IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).IsCompactLayout}"
                    ToolTip.Tip="{loc:Tr 'Свернуть дерево проекта'}"
                    AutomationProperties.Name="{loc:Tr 'Свернуть дерево проекта'}">
              <Path Data="M10,3 L5,8 L10,13" Width="15" Height="16"
                    Stroke="{DynamicResource SidebarSubTextBrush}" StrokeThickness="1.5" />
            </Button>
          </Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Series}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="shell:SeriesNode">
                  <StackPanel>
                    <Button Classes="treeNode seriesNode" Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="{Binding DisplayTitle}">
                      <Grid ColumnDefinitions="14,16,*" ColumnSpacing="4">
                        <TextBlock Grid.Column="0" Classes="treeChevron" FontFamily="{StaticResource SymbolsFontFamily}"
                                   Text="{Binding Chevron}" />
                        <Path Grid.Column="1" Classes="treeFolder"
                              Data="M1.5,4.5 V3 A1.5,1.5 0 0 1 3,1.5 H7 L8.8,3.5 H15 A1.5,1.5 0 0 1 16.5,5 V12.5 A1.5,1.5 0 0 1 15,14 H3 A1.5,1.5 0 0 1 1.5,12.5 Z" />
                        <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Books}" IsVisible="{Binding IsExpanded}"
                                  Margin="14,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="shell:BookNode">
                          <StackPanel>
                            <Button Classes="treeNode bookNode" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding DisplayTitle}">
                              <Grid ColumnDefinitions="14,16,*" ColumnSpacing="4">
                                <TextBlock Grid.Column="0" Classes="treeChevron" FontFamily="{StaticResource SymbolsFontFamily}"
                                           Text="{Binding Chevron}" />
                                <Path Grid.Column="1" Classes="treeFolder"
                                      Data="M1.5,4.5 V3 A1.5,1.5 0 0 1 3,1.5 H7 L8.8,3.5 H15 A1.5,1.5 0 0 1 16.5,5 V12.5 A1.5,1.5 0 0 1 15,14 H3 A1.5,1.5 0 0 1 1.5,12.5 Z" />
                                <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}"
                                           TextTrimming="CharacterEllipsis" />
                              </Grid>
                            </Button>
                            <ItemsControl ItemsSource="{Binding Chapters}" IsVisible="{Binding IsExpanded}"
                                          Margin="14,0,0,0">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="shell:ChapterNode">
                                  <StackPanel>
                                    <Border Classes="chapterRow" Background="Transparent">
                                      <Grid ColumnDefinitions="*,24">
                                        <Button Grid.Column="0" Classes="treeNode chapterNode"
                                                Command="{Binding ToggleExpandedCommand}" ToolTip.Tip="{Binding DisplayTitle}">
                                          <Grid ColumnDefinitions="14,16,*" ColumnSpacing="4">
                                            <TextBlock Grid.Column="0" Classes="treeChevron" FontFamily="{StaticResource SymbolsFontFamily}"
                                                       Text="{Binding Chevron}" />
                                            <Path Grid.Column="1" Classes="treeFolder"
                                                  Data="M1.5,4.5 V3 A1.5,1.5 0 0 1 3,1.5 H7 L8.8,3.5 H15 A1.5,1.5 0 0 1 16.5,5 V12.5 A1.5,1.5 0 0 1 15,14 H3 A1.5,1.5 0 0 1 1.5,12.5 Z" />
                                            <TextBlock Grid.Column="2" Text="{Binding DisplayTitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                          </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Classes="chapterAdd"
                                                Command="{Binding AddSceneCommand}"
                                                ToolTip.Tip="{loc:Tr 'Добавить сцену'}">
                                          <TextBlock Text="&#xE710;" FontFamily="{StaticResource SymbolsFontFamily}" />
                                        </Button>
                                      </Grid>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Scenes}" IsVisible="{Binding IsExpanded}"
                                                  Margin="14,0,0,0">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="shell:SceneNode">
                                          <Button Classes="sceneRow" Classes.current="{Binding IsCurrent}" Command="{Binding OpenCommand}"
                                                  Background="{Binding RowBackground}" ToolTip.Tip="{Binding DisplayTitle}">
                                            <Grid ColumnDefinitions="16,*" ColumnSpacing="4">
                                              <Path Grid.Column="0" Classes="treeDocument"
                                                    Data="M3,1.5 H9 L13,5.5 V14 H3 Z M9,1.5 V5.5 H13" />
                                              <TextBlock Grid.Column="1" Text="{Binding DisplayTitle}"
                                                         TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                          </Button>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </DataTemplate>

    <DataTemplate DataType="shell:SceneContextViewModel">
      <views:SceneContextView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
