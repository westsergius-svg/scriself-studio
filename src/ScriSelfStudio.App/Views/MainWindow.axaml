<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
        xmlns:shell="clr-namespace:ScriSelfStudio.App.Shell"
        xmlns:model="clr-namespace:ScriSelfStudio.Core.Model;assembly=ScriSelfStudio.Core"
        xmlns:views="clr-namespace:ScriSelfStudio.App.Views"
        x:Class="ScriSelfStudio.App.Views.MainWindow"
        x:DataType="shell:ShellViewModel"
        Classes.cabinet="{Binding IsCompactLayout}"
        Classes.jam="{Binding IsJamTheme}"
        Classes.studio="{Binding IsStudioTheme}"
        Classes.menuNavigation="{Binding UseDropdownNavigation}"
        Title="ScriSelf Studio"
        Icon="/Assets/scriself.png"
        Width="1536"
        Height="1024"
        MinWidth="800"
        MinHeight="480"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="False"
        WindowStartupLocation="CenterScreen">
  <Window.KeyBindings>
    <KeyBinding Gesture="F1" Command="{Binding OpenHelpCommand}" />
    <!-- Ctrl+S работает на любом экране, не только в редакторе (ТЗ п. 11). -->
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Meta+S" Command="{Binding SaveCommand}" />
    <!-- Esc выключает режим «Холст»: команда редактора, доступна только внутри режима. -->
    <KeyBinding Gesture="Escape" Command="{Binding ExitFullCanvasCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding ToggleBookTreeCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+I" Command="{Binding ToggleScenePanelCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector=":is(Window)">
      <Setter Property="Background" Value="{DynamicResource SurfaceChromeBrush}" />
    </Style>
    <Style Selector="Border.compactHeader">
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <!-- Разделитель панелей: тонкая линия, подсвечивается при наведении и перетаскивании. -->
    <Style Selector="Thumb.paneSplitter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Thumb.paneSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceBorderBrush}" />
    </Style>
    <Style Selector="Thumb.paneSplitter:pressed">
      <Setter Property="Background" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="Thumb.paneSplitter:dragging">
      <Setter Property="Background" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="ListBox.chapterList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4,6,8" />
    </Style>
    <Style Selector="ListBox.chapterList > ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <!-- Выбранная глава: мягкий кремовый фон вместо акцентной заливки Fluent. -->
    <Style Selector="ListBox.chapterList > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="ListBox.chapterList > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <!-- Шеврон раскрытия/сворачивания главы. -->
    <Style Selector="Button.chapterToggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.chapterToggle:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.chapterToggle TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource SymbolsFontFamily}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.treeNode">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="5,3" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.treeNode:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.treeNode.seriesNode">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.treeNode.bookNode">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Button.treeNode.chapterNode">
      <Setter Property="Margin" Value="0,1" />
    </Style>
    <Style Selector="Button.chapterAdd">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style Selector="Border.chapterRow:pointerover Button.chapterAdd">
      <Setter Property="Opacity" Value="1" />
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="Button.chapterAdd:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Button.chapterAdd TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource SymbolsFontFamily}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ActiveAccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.treeChevron">
      <Setter Property="FontFamily" Value="{StaticResource SymbolsFontFamily}" />
      <Setter Property="FontSize" Value="9" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.treeFolder">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource ActiveAccentBrush}" />
      <Setter Property="StrokeThickness" Value="1.2" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.treeDocument">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="StrokeThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.sceneRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.sceneRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.treeFooter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
    </Style>
    <Style Selector="Button.treeFooter:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <!-- Шапка макета: бренд во всю первую строку, вкладки экранов во второй. -->
    <Style Selector="TextBlock.shellBrand">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTitleBrush}" />
    </Style>
    <Style Selector="TextBlock.shellBrandTag">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ShellSubtitleBrush}" />
    </Style>
    <Style Selector="Button.shellTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Height" Value="34" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.shellTab.active">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    </Style>
    <Style Selector="Button.shellIcon:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.projectHeader">
      <Setter Property="MaxWidth" Value="420" />
    </Style>
    <ContainerQuery Name="shell" Query="max-width:1000">
      <Style Selector="TextBlock.shellBrandTag">
        <Setter Property="IsVisible" Value="False" />
      </Style>
      <Style Selector="Border.projectHeader">
        <Setter Property="MaxWidth" Value="340" />
      </Style>
    </ContainerQuery>
    <Style Selector="Button.shellTab:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.shellTabText">
      <Setter Property="Foreground" Value="{DynamicResource ShellNavBrush}" />
    </Style>
    <Style Selector="TextBlock.shellTabIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellNavBrush}" />
    </Style>
    <Style Selector="Path.shellTabIcon">
      <Setter Property="Stroke" Value="{DynamicResource ShellNavBrush}" />
    </Style>
    <Style Selector="Button.shellTab.active TextBlock.shellTabText">
      <Setter Property="Foreground" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="Button.shellTab.active TextBlock.shellTabIcon">
      <Setter Property="Foreground" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="Button.shellTab.active Path.shellTabIcon">
      <Setter Property="Stroke" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="Button.shellIcon">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource ShellNavBrush}" />
    </Style>
    <Style Selector="Button.shellIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.shellIcon:checked">
      <Setter Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ShellNavActiveBrush}" />
    </Style>
    <Style Selector="ToggleButton.shellIcon:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource ShellNavHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.projectCaption">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource ShellTitleBrush}" />
    </Style>
    <Style Selector="Button.chipClose">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
    </Style>
    <Style Selector="Button.chipClose:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Border.sceneChip">
      <Setter Property="Background" Value="{DynamicResource MapCardActiveBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="TextBlock.sceneHeading">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style Selector="TextBlock.panelLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
    </Style>
    <Style Selector="Button.panelAction">
      <Setter Property="Background" Value="{DynamicResource SurfaceFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Height" Value="36" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.panelAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <StyleInclude Source="/Views/CabinetStyles.axaml" />
    <StyleInclude Source="/Views/JamStyles.axaml" />
    <StyleInclude Source="/Views/StudioStyles.axaml" />
    <Style Selector=":is(Window).menuNavigation Border.architectureTabs">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Border.compactHeader">
      <Setter Property="Padding" Value="16,10" />
    </Style>
  </Window.Styles>
  <Panel Container.Name="shell" Container.Sizing="Width">
  <!-- Нативное размытие рабочего стола и мягкие цветовые отражения под стеклом.
       FallbackColor сохраняет читаемый фон на платформах без acrylic. -->
  <Panel x:Name="JamBackdrop" IsVisible="{Binding IsJamTheme}" IsHitTestVisible="False" ClipToBounds="True">
    <ExperimentalAcrylicBorder>
      <ExperimentalAcrylicBorder.Material>
        <ExperimentalAcrylicMaterial BackgroundSource="Digger" TintColor="#EEF1FA"
                                     TintOpacity="0.6" MaterialOpacity="0.7" FallbackColor="#EAF0FA" />
      </ExperimentalAcrylicBorder.Material>
    </ExperimentalAcrylicBorder>
    <Border>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#90EBE9F8" Offset="0" />
          <GradientStop Color="#50F4F7FD" Offset="0.5" />
          <GradientStop Color="#90D7EAF8" Offset="1" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="0%,20%" GradientOrigin="0%,20%" RadiusX="65%" RadiusY="85%">
          <GradientStop Color="#80EBC1DA" Offset="0" />
          <GradientStop Color="#00EBC1DA" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
    <Border>
      <Border.Background>
        <RadialGradientBrush Center="95%,75%" GradientOrigin="95%,75%" RadiusX="65%" RadiusY="80%">
          <GradientStop Color="#703EBBDE" Offset="0" />
          <GradientStop Color="#003EBBDE" Offset="1" />
        </RadialGradientBrush>
      </Border.Background>
    </Border>
  </Panel>
  <DockPanel>
    <views:StudioCommandBar DockPanel.Dock="Top" IsVisible="{Binding ShowStudioChrome}" />
    <Menu DockPanel.Dock="Top" IsVisible="{Binding !IsStudioTheme}" Background="{DynamicResource SurfaceChromeBrush}" Padding="12,0">
      <MenuItem Header="{loc:Tr 'Справка'}">
        <MenuItem Header="{loc:Tr 'Помощь по ScriSelf'}" Command="{Binding OpenHelpCommand}" InputGesture="F1" />
        <MenuItem Header="{loc:Tr 'О программе'}" Command="{Binding OpenAboutCommand}" />
        <MenuItem Header="{loc:Tr 'Лицензии'}" Command="{Binding OpenLicensesCommand}" />
      </MenuItem>
    </Menu>
    <views:StudioToolRail DockPanel.Dock="Left" IsVisible="{Binding ShowStudioChrome}" />
    <Border Classes="compactHeader" DockPanel.Dock="Top" IsVisible="{Binding ShowCabinetChrome}"
            Background="{DynamicResource SurfaceChromeBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
        <views:CabinetNavigation VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ProjectName}" FontSize="13" FontWeight="SemiBold"
                   Foreground="{DynamicResource ShellNavBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ProjectName}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button x:Name="ProjectTreeToggle" Classes="cabinetHeaderAction" Classes.active="{Binding ShowBookTree}" Content="{loc:Tr 'Дерево проекта'}"
                  Command="{Binding ToggleBookTreeCommand}" IsVisible="{Binding IsBookTreeAvailable}" ToolTip.Tip="{loc:Tr 'Дерево проекта (Ctrl+Shift+B)'}" />
          <Button Classes="cabinetHeaderAction" Classes.active="{Binding ShowScenePanel}" Content="{loc:Tr 'Контекст сцены'}"
                  Command="{Binding ToggleScenePanelCommand}" IsVisible="{Binding IsFullCanvasAvailable}" ToolTip.Tip="{loc:Tr 'Контекст сцены (Ctrl+Shift+I)'}" />
          <Button Classes="cabinetHeaderAction" Content="{loc:Tr 'Сохранить'}" Command="{Binding SaveCommand}"
                  IsVisible="{Binding IsProjectOpen}" ToolTip.Tip="{loc:Tr 'Сохранить (Ctrl+S)'}" />
          <views:ThemeSwitcherView />
        </StackPanel>
      </Grid>
    </Border>
    <!-- Шапка макета: знак, название продукта, подпись, вкладки экранов и путь к проекту. -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding ShowClassicHeader}"
            Background="{DynamicResource SurfaceChromeBrush}">
      <StackPanel>
        <Grid Height="52" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Margin="24,0,24,0">
          <views:ThemeSwitcherView Grid.Column="3" VerticalAlignment="Center" />
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="13" VerticalAlignment="Center">
            <Viewbox Width="31" Height="31">
              <Canvas Width="32" Height="32">
                <Path Fill="{DynamicResource ShellTitleBrush}"
                      Data="M29.4,2.3 C22.9,2.1 16.4,4.5 11.8,9.1 C7.9,13 5.8,17.5 5.0,21.6 C4.7,23.1 6.0,24.0 7.3,23.3 C15.0,18.4 21.1,13.8 25.2,8.8 C27.8,5.7 29.2,3.3 29.7,2.5 C29.8,2.4 29.6,2.3 29.4,2.3 Z" />
                <Path Stroke="{DynamicResource ShellTitleBrush}" StrokeThickness="1.8" StrokeLineCap="Round"
                      Data="M6.0,22.6 L1.8,29.4" />
                <Path Stroke="{DynamicResource SurfaceChromeBrush}" StrokeThickness="1.1" StrokeLineCap="Round"
                      Data="M27.0,4.6 C21.0,7.4 15.0,12.0 10.4,17.6" />
              </Canvas>
            </Viewbox>
            <TextBlock Classes="shellBrand" Text="ScriSelf Studio" VerticalAlignment="Center" />
            <TextBlock Classes="shellBrandTag" Text="{loc:Tr 'Всё под рукой'}" VerticalAlignment="Center" Margin="4,3,0,0" />
          </StackPanel>
          <Border Grid.Column="2" Classes="projectHeader" VerticalAlignment="Center">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Classes="projectCaption" Text="{Binding ProjectCaption}"
                         TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                         ToolTip.Tip="{Binding ProjectCaption}" />
              <Button Grid.Column="1" Classes="shellIcon" ToolTip.Tip="{loc:Tr 'Действия проекта'}">
                <TextBlock Text="…" FontSize="18" VerticalAlignment="Center" />
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuItem Header="{loc:Tr 'Сохранить проект'}" Command="{Binding SaveCommand}"
                              IsVisible="{Binding IsProjectOpen}" />
                    <MenuItem Header="{loc:Tr 'Открыть папку проекта'}"
                              Command="{Binding OpenProjectFolderCommand}" />
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </Grid>
          </Border>
        </Grid>

        <ScrollViewer Height="44" Margin="16,0" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Stretch">
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsLauncherActive}"
                      Command="{Binding OpenLauncherCommand}" ToolTip.Tip="{loc:Tr 'Проект'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Path Classes="shellTabIcon" StrokeThickness="1.4" StrokeJoin="Round"
                        Data="M1.6,5.2 A1.3,1.3 0 0 1 2.9,3.9 H6.6 L8.3,6.1 H15.1 A1.3,1.3 0 0 1 16.4,7.4 V14.4 A1.3,1.3 0 0 1 15.1,15.7 H2.9 A1.3,1.3 0 0 1 1.6,14.4 Z"
                        Width="18" Height="18" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Проект'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsLauncherActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsMapActive}"
                      Command="{Binding OpenMapCommand}" ToolTip.Tip="{loc:Tr 'Карта книги'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE736;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Карта'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsMapActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsEditorActive}"
                      Command="{Binding OpenEditorCommand}" ToolTip.Tip="{loc:Tr 'Редактор'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE8EF;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Редактор'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsEditorActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsCharactersActive}"
                      Command="{Binding OpenCharactersCommand}" ToolTip.Tip="{loc:Tr 'Персонажи'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE77B;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Персонажи'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsCharactersActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsLinesActive}"
                      Command="{Binding OpenLinesCommand}" ToolTip.Tip="{loc:Tr 'Сюжетные линии'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE8D4;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Линии'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsLinesActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsExportActive}"
                      Command="{Binding OpenExportCommand}" ToolTip.Tip="{loc:Tr 'Экспорт'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xEDE1;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Экспорт'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsExportActive}" />
            </Grid>
            <Grid RowDefinitions="*,2">
              <Button Grid.Row="0" Classes="shellTab" Classes.active="{Binding IsSettingsActive}"
                      Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{loc:Tr 'Настройки'}">
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <TextBlock Classes="shellTabIcon" FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE713;"
                             FontSize="16" VerticalAlignment="Center" />
                  <TextBlock Classes="shellTabText" Text="{loc:Tr 'Настройки'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Border Grid.Row="1" Background="{DynamicResource ShellNavActiveBrush}"
                      IsVisible="{Binding IsSettingsActive}" />
            </Grid>
            <Button x:Name="ClassicProjectTreeToggle" Classes="cabinetHeaderAction"
                    Content="{loc:Tr 'Дерево проекта'}" Classes.active="{Binding ShowBookTree}"
                    Command="{Binding ToggleBookTreeCommand}" IsVisible="{Binding IsBookTreeAvailable}"
                    ToolTip.Tip="{loc:Tr 'Дерево проекта (Ctrl+Shift+B)'}" />
            <Button x:Name="ClassicSceneContextToggle" Classes="cabinetHeaderAction"
                    Content="{loc:Tr 'Контекст сцены'}" Classes.active="{Binding ShowScenePanel}"
                    Command="{Binding ToggleScenePanelCommand}" IsVisible="{Binding IsFullCanvasAvailable}"
                    ToolTip.Tip="{loc:Tr 'Контекст сцены (Ctrl+Shift+I)'}" />
          </StackPanel>

        </ScrollViewer>
      </StackPanel>
    </Border>

    <!-- Подвал макета: статус-бар (рукопись / статус сохранения / быстрые действия). -->
    <Border Classes="shellStatusBar" DockPanel.Dock="Bottom" Height="36" Background="{DynamicResource SurfaceChromeBrush}"
            IsVisible="{Binding ShowStatusBar}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="24" Margin="24,0,24,0">
        <TextBlock Grid.Column="0" Text="{Binding BreadcrumbsText}" VerticalAlignment="Center"
                   FontSize="12" Foreground="{DynamicResource ShellNavBrush}" TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding BreadcrumbsText}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="7" Height="7" Fill="{DynamicResource SavedDotBrush}"
                   IsVisible="{Binding IsAutosaveEnabled}" />
          <TextBlock Text="{Binding AutosaveText}" FontSize="12" Foreground="{DynamicResource ShellSubtitleBrush}" />
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding StatusStatsText}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" FontSize="12.5" Foreground="{DynamicResource ShellNavBrush}" />
      </Grid>
    </Border>

    <!-- Основное рабочее пространство. -->
    <Grid x:Name="WorkspaceGrid" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
      <!-- Левое дерево структуры книги -->
      <ContentControl x:Name="ProjectTreePanel" Grid.Column="0" Content="{Binding BookTree}" IsVisible="{Binding ShowBookTree}" Width="{Binding BookTreeWidth}" />
      <Thumb Grid.Column="1" x:Name="BookTreeSplitter" Classes="paneSplitter" Width="6" IsVisible="{Binding ShowBookTree}" Cursor="SizeWestEast" />

      <!-- Основной экран -->
      <ContentControl Grid.Column="2" Content="{Binding Current}" />

      <!-- Правая панель контекста сцены -->
      <Thumb Grid.Column="3" x:Name="SceneContextSplitter" Classes="paneSplitter" Width="6" IsVisible="{Binding ShowScenePanel}" Cursor="SizeWestEast" />
      <ContentControl Grid.Column="4" Content="{Binding SceneContext}" IsVisible="{Binding ShowScenePanel}" Width="{Binding SceneContextWidth}" />
    </Grid>
  </DockPanel>
  </Panel>
</Window>
