<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:shell="clr-namespace:ScriSelfStudio.App.Shell"
             x:Class="ScriSelfStudio.App.Views.ArchitectureHostView"
             x:DataType="shell:ArchitectureHostViewModel"
             Background="{DynamicResource SurfaceCanvasBrush}">
  <Grid RowDefinitions="Auto,*">
    <!-- Вкладки архитектуры книги в порядке макета. -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceChromeBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="24,10,24,10">
        <Button Classes="tab" Classes.active="{Binding IsMapSelected}" Content="{loc:Tr 'Карта книги'}"
                Command="{Binding OpenMapCommand}" />
        <Button Classes="tab" Classes.active="{Binding IsLinesSelected}" Content="{loc:Tr 'Сюжетные линии'}"
                Command="{Binding OpenLinesCommand}" />
        <Button Classes="tab" Classes.active="{Binding IsCharactersSelected}" Content="{loc:Tr 'Персонажи'}"
                Command="{Binding OpenCharactersCommand}" />
      </StackPanel>
    </Border>

    <!-- Дочерний экран вкладки (карта, персонажи или сюжетные линии). -->
    <ContentControl Grid.Row="1" Content="{Binding Current}" />
  </Grid>
</UserControl>