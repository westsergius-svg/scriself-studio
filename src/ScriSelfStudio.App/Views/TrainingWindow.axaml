<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:ScriSelfStudio.Presentation.Localization"
        xmlns:help="using:ScriSelfStudio.Presentation.Help"
        x:Class="ScriSelfStudio.App.Views.TrainingWindow"
        x:DataType="help:TrainingViewModel"
        Title="{loc:Tr 'Обучение — ScriSelf Studio'}" Icon="/Assets/scriself.png"
        Width="1280" Height="860" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceChromeBrush}">
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <Border Padding="20,14" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr 'Обучение ScriSelf Studio'}" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
          <TextBlock Text="{loc:Tr 'Уроки на реальных экранах программы · на русском языке'}" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
        </StackPanel>
        <Button Grid.Column="1" Name="TrainingFullScreenButton" Content="{loc:Tr 'На весь экран (F11)'}" Command="{Binding ToggleFullScreenCommand}" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="#242424" Margin="16,12">
      <Image Name="TrainingSlideImage" Stretch="Uniform" AutomationProperties.Name="{Binding CurrentSlide.Transcript}" />
    </Border>
    <Expander Grid.Row="2" Name="TrainingTranscript" Header="{loc:Tr 'Текст урока'}" Margin="20,0,20,8" HorizontalAlignment="Stretch">
      <ScrollViewer MaxHeight="180" HorizontalScrollBarVisibility="Disabled">
        <SelectableTextBlock Text="{Binding CurrentSlide.Transcript}" TextWrapping="Wrap" FontSize="15" LineHeight="24" Margin="12" />
      </ScrollViewer>
    </Expander>
    <Border Grid.Row="3" Padding="20,12" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,0">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10">
          <ComboBox Name="TrainingLessonPicker" ItemsSource="{Binding Slides}" SelectedIndex="{Binding SelectedIndex}" HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr 'Урок обучения'}">
            <ComboBox.ItemTemplate><DataTemplate x:DataType="help:TrainingSlide"><TextBlock Text="{Binding Caption}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Grid.Column="1" Name="TrainingPosition" Text="{Binding Position}" VerticalAlignment="Center" Margin="8,0" />
          <Button Grid.Column="2" Name="TrainingPreviousButton" Content="{loc:Tr 'Назад'}" Command="{Binding PreviousCommand}" />
          <Button Grid.Column="3" Name="TrainingNextButton" Content="{loc:Tr 'Далее'}" Command="{Binding NextCommand}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <TextBlock Text="{loc:Tr '← → — листать · F11 — полный экран · Esc — выйти'}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SidebarSubTextBrush}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{loc:Tr 'Начать сначала'}" Command="{Binding RestartCommand}" Padding="8,4" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
