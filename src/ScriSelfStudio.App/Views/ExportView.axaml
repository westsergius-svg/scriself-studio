<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:export="clr-namespace:ScriSelfStudio.Presentation.Export;assembly=ScriSelfStudio.Presentation"
             x:Class="ScriSelfStudio.App.Views.ExportView"
             x:DataType="export:ExportViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <!-- Шапка -->
    <StackPanel Grid.Row="0" Margin="0,0,0,20">
      <TextBlock Text="Экспорт" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
      <TextBlock Text="Выберите формат и настройки для экспорта вашей книги" FontSize="14" Foreground="{DynamicResource SidebarSubTextBrush}" Margin="0,4,0,0" />
    </StackPanel>

    <!-- Сообщения -->
    <StackPanel Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,0" Spacing="8">
      <Border IsVisible="{Binding HasStatus}" Background="#ECFDF5" BorderBrush="#10B981" BorderThickness="1" CornerRadius="6" Padding="12,6">
        <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" />
      </Border>
      <Border IsVisible="{Binding HasError}" Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="6" Padding="12,6">
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" />
      </Border>
    </StackPanel>

    <!-- Контент экспорта -->
    <Grid Grid.Row="1" ColumnDefinitions="260,*,340" Margin="0">
      <!-- 1. Формат (Левая колонка) -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="16" Margin="0,0,16,0">
        <StackPanel Spacing="12">
          <TextBlock Text="Формат" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" Margin="0,0,0,4" />
          <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="export:ExportFormatOption">
                <Border CornerRadius="10" Padding="12,10" Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#5B7BB2" Margin="0,0,12,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="{Binding IconGlyph}" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource HeadingBrush}" />
                      <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

      <!-- 2. Настройки экспорта (Средняя колонка) -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="24" Margin="0,0,16,0">
          <StackPanel Spacing="20">
            <TextBlock Text="Настройки экспорта (DOCX)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />

            <!-- Диапазон -->
            <StackPanel Spacing="10">
              <TextBlock Text="Диапазон" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
              <RadioButton Content="Вся книга" IsChecked="True" GroupName="RangeGroup" />
              <RadioButton Content="Текущая книга" GroupName="RangeGroup" />
              <RadioButton Content="Текущая глава" GroupName="RangeGroup" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <RadioButton Content="Выбранные сцены" GroupName="RangeGroup" VerticalAlignment="Center" />
                <ComboBox PlaceholderText="Выберите сцены..." Width="180" Height="32" IsEnabled="False" />
              </StackPanel>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" Margin="0,4" />

            <!-- Оформление -->
            <StackPanel Spacing="12">
              <TextBlock Text="Оформление" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
              <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,*">
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,8">
                  <TextBlock Text="Стиль документа" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding DocumentStyles}" SelectedItem="{Binding SelectedDocumentStyle}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,8">
                  <TextBlock Text="Размер шрифта" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding SelectedFontSize}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,8,0">
                  <TextBlock Text="Шрифт" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,0">
                  <TextBlock Text="Межстрочный интервал" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" Margin="0,0,0,4" />
                  <ComboBox ItemsSource="{Binding LineSpacings}" SelectedItem="{Binding SelectedLineSpacing}" HorizontalAlignment="Stretch" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" Margin="0,4" />

            <!-- Опции -->
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*">
              <CheckBox Grid.Row="0" Grid.Column="0" Content="Включить титульный лист" IsChecked="{Binding IncludeTitlePage}" Margin="0,4" />
              <CheckBox Grid.Row="0" Grid.Column="1" Content="Нумерация страниц" IsChecked="{Binding PageNumbering}" Margin="0,4" />
              <CheckBox Grid.Row="1" Grid.Column="0" Content="Содержание" IsChecked="{Binding TableOfContents}" Margin="0,4" />
              <CheckBox Grid.Row="1" Grid.Column="1" Content="Сноски и примечания" IsChecked="{Binding Footnotes}" Margin="0,4" />
              <CheckBox Grid.Row="2" Grid.Column="0" Content="Сохранить форматирование" IsChecked="{Binding PreserveFormatting}" Margin="0,4" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" Margin="0,4" />

            <!-- Кнопки действий -->
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,8,0,0">
              <Button Grid.Column="0" Content="Сохранить как шаблон..." Command="{Binding SaveTemplateCommand}" Padding="12,8" />
              <Button Grid.Column="2" Content="👁 Предпросмотр" Command="{Binding PreviewCommand}" Padding="12,8" Margin="0,0,8,0" />
              <Button Grid.Column="3" Content="📥 Экспортировать" Command="{Binding ExportCommand}" Padding="16,8" Background="#4F6D46" Foreground="White" FontWeight="Bold" />
            </Grid>
          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- 3. Предварительный просмотр (Правая колонка) -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceCanvasBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="20">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Grid.Row="0" Text="Предварительный просмотр" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" Margin="0,0,0,16" />
          <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="24" BoxShadow="0 4 12 #15000000">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" HorizontalAlignment="Stretch">
              <!-- Заголовок книги -->
              <TextBlock Grid.Row="0" Text="{Binding PreviewTitle}" FontSize="20" FontWeight="Bold" FontFamily="Georgia" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,4" Foreground="#1F2937" />
              <TextBlock Grid.Row="1" Text="{Binding PreviewSubtitle}" FontSize="13" Foreground="#6B7280" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16" />

              <!-- Разделитель -->
              <TextBlock Grid.Row="2" Text="❖   ❖   ❖" Foreground="#D1D5DB" FontSize="10" HorizontalAlignment="Center" Margin="0,0,0,24" />

              <!-- Глава и текст -->
              <StackPanel Grid.Row="3" Spacing="12">
                <TextBlock Text="{Binding PreviewChapterHeader}" FontSize="15" FontWeight="Bold" FontFamily="Georgia" Foreground="#1F2937" />
                <TextBlock Text="{Binding PreviewTextExcerpt}" FontSize="13" LineHeight="20" Foreground="#374151" TextWrapping="Wrap" />
              </StackPanel>

              <!-- Футер страницы -->
              <TextBlock Grid.Row="4" Text="{Binding PreviewPageCounter}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,30,0,0" />
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
