<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ScriSelfStudio.App.Views">
  <Style Selector="Border.projectTreeSurface">
    <Setter Property="Background" Value="{DynamicResource SurfaceCanvasBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Button.cabinetHeaderAction">
    <Setter Property="MinHeight" Value="34" /><Setter Property="Padding" Value="10,6" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource ShellNavBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="Button.cabinetHeaderAction.active">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
  </Style>
  <Style Selector="Button.treeCollapse">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.treeCollapse:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
  </Style>
  <Style Selector=":is(Window).cabinet Button.treeNode">
    <Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector=":is(Window).cabinet Button.sceneRow">
    <Setter Property="MinHeight" Value="32" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector=":is(Window).cabinet Button.chapterToggle">
    <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
  </Style>
  <Style Selector=":is(Window).cabinet TextBlock.panelLabel"><Setter Property="FontSize" Value="12" /></Style>
  <Style Selector=":is(Window).cabinet Border.architectureTabs"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector=":is(Window).cabinet Button.sceneRow.current /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource SidebarActiveTextBrush}" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
</Styles>
