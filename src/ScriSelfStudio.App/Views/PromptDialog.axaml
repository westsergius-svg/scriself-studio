<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
        xmlns:dialogs="clr-namespace:ScriSelfStudio.Presentation.Dialogs;assembly=ScriSelfStudio.Presentation"
        x:Class="ScriSelfStudio.App.Views.PromptDialog"
        x:DataType="dialogs:PromptDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20" Spacing="12">
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBox Text="{Binding Value}" PlaceholderText="{loc:Tr 'Название'}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="{loc:Tr 'ОК'}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="90" />
      <Button Content="{loc:Tr 'Отмена'}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" />
    </StackPanel>
  </StackPanel>
</Window>
