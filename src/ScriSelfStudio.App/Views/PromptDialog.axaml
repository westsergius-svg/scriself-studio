<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
        xmlns:dialogs="clr-namespace:ScriSelfStudio.Presentation.Dialogs;assembly=ScriSelfStudio.Presentation"
        x:Class="ScriSelfStudio.App.Views.PromptDialog"
        x:DataType="dialogs:PromptDialogViewModel"
        Title="{Binding Title}"
        Width="440"
        Height="220"
        MinWidth="320"
        MinHeight="180"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="*,Auto" RowSpacing="12">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <TextBox Text="{Binding Value}" PlaceholderText="{Binding InitialValue}" />
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Right">
      <Button Grid.Column="{OnPlatform macOS=1, Default=0}" Content="{loc:Tr 'ОК'}" Command="{Binding ConfirmCommand}" IsDefault="True" MinWidth="90" />
      <Button Grid.Column="{OnPlatform macOS=0, Default=1}" Content="{loc:Tr 'Отмена'}" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="90" />
    </Grid>
  </Grid>
</Window>
