<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:shell="clr-namespace:ScriSelfStudio.App.Shell"
             xmlns:model="clr-namespace:ScriSelfStudio.Core.Model;assembly=ScriSelfStudio.Core"
             x:Class="ScriSelfStudio.App.Views.SceneContextView"
             x:DataType="shell:SceneContextViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.panelLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBox.panelField">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource PaperTextBrush}" />
    </Style>
    <Style Selector="Border.panelField">
      <Setter Property="Background" Value="{DynamicResource SurfaceFieldBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.panelChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.panelChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0"
          PointerPressed="OnPanelPointerPressed">
    <ScrollViewer>
      <StackPanel>
        <TextBlock Margin="16" Classes="muted" Text="{loc:Tr 'Сцена не открыта.'}" IsVisible="{Binding !HasScene}" />

        <StackPanel Margin="16" Spacing="14" IsVisible="{Binding HasScene}">
          <!-- Заголовок панели -->
          <StackPanel Spacing="6">
            <Border Classes="panelChip" HorizontalAlignment="Left">
              <TextBlock Text="{loc:Tr 'Сцена'}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource ActiveAccentBrush}" />
            </Border>
            <TextBlock Classes="cardHeading" Text="{Binding SceneTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Breadcrumb}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Ошибка сохранения -->
          <Border Background="{DynamicResource DangerFillBrush}" CornerRadius="8" Padding="10"
                  IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource DangerTextBrush}" />
          </Border>

          <!-- Кратко -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'КРАТКО'}" />
            <Border Classes="panelField">
            <TextBox Classes="panelField" Text="{Binding Summary, Mode=TwoWay}" MinHeight="70" PlaceholderText="{loc:Tr 'О чём сцена…'}" />
          </Border>
          </StackPanel>

          <!-- Статус -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'СТАТУС'}" />
            <WrapPanel>
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusIdea}" Content="{loc:Tr 'Идея'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Idea}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusDraft}" Content="{loc:Tr 'Черновик'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Draft}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusRevised}" Content="{loc:Tr 'В работе'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Revised}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusFinal}" Content="{loc:Tr 'Готово'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Final}" />
            </WrapPanel>
          </StackPanel>

          <!-- Ключевые сюжетные линии -->
          <StackPanel Spacing="8">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'КЛЮЧЕВЫЕ СЮЖЕТНЫЕ ЛИНИИ'}" />
            <ItemsControl ItemsSource="{Binding AssignedSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:SceneStepEntry">
                  <StackPanel Spacing="4" Margin="0,0,0,5">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="panelChip descriptionToggle" Grid.Column="0"
                              Command="{Binding ToggleDescriptionCommand}"
                              ToolTip.Tip="{loc:Tr 'Показать описание этапа'}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Brush}" />
                          <TextBlock Text="{Binding Label}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tool" Grid.Column="1" Padding="2" Margin="4,0,0,0"
                              Command="{Binding RemoveCommand}" ToolTip.Tip="{loc:Tr 'Снять шаг со сцены'}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="10" />
                      </Button>
                    </Grid>
                    <StackPanel Margin="8,0,4,4" Spacing="3"
                                IsVisible="{Binding IsDescriptionExpanded}">
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding StepHeading}" />
                      <TextBlock Text="{Binding StepDescriptionText}" FontSize="12" TextWrapping="Wrap" />
                      <StackPanel IsVisible="{Binding HasLineDescription}" Spacing="2">
                        <TextBlock Classes="muted" FontSize="10" Text="{Binding LineHeading}" />
                        <TextBlock Text="{Binding LineDescription}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Сцена не привязана к шагам линий. Выберите линию и шаг ниже.'}"
                       IsVisible="{Binding !HasAssignedSteps}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'У проекта нет линий с шагами. Создайте линию на экране «Сюжетные линии».'}"
                       IsVisible="{Binding !HasLineOptions}" />

            <StackPanel Spacing="6" IsVisible="{Binding HasLineOptions}">
              <ComboBox HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding LineOptions}"
                        SelectedItem="{Binding SelectedLineOption, Mode=TwoWay}"
                        ToolTip.Tip="{loc:Tr 'Сюжетная линия'}" />
              <ComboBox HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding StepOptions}"
                        SelectedItem="{Binding SelectedStepOption, Mode=TwoWay}"
                        IsVisible="{Binding HasStepOptions}"
                        ToolTip.Tip="{loc:Tr 'Шаг линии'}" />
              <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding AddStepCommand}" IsEnabled="{Binding CanAddStep}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Tr 'Добавить шаг'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- Персонажи -->
          <StackPanel Spacing="8">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'ПЕРСОНАЖИ'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Персонажи не упомянуты. Добавьте участника шага, привязанного к сцене.'}"
                       IsVisible="{Binding !HasCharacters}" />
            <ItemsControl ItemsSource="{Binding Characters}" IsVisible="{Binding HasCharacters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:CharacterEntry">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <Border Classes="avatar" Width="34" Height="34" CornerRadius="17">
                      <TextBlock Classes="avatarLetter" FontSize="16" Text="{Binding Initial}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Classes="muted" Text="{Binding RoleLabel}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Classes="panelChip descriptionToggle" HorizontalAlignment="Left"
                              IsVisible="{Binding HasStep}" Command="{Binding ToggleDescriptionCommand}"
                              ToolTip.Tip="{loc:Tr 'Показать описание этапа'}">
                        <TextBlock Text="{Binding StepLabel}" FontSize="11" />
                      </Button>
                      <TextBlock Text="{Binding StepDescriptionText}" FontSize="12" TextWrapping="Wrap"
                                 IsVisible="{Binding IsDescriptionExpanded}" />
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Сначала привяжите сцену к шагу линии — персонаж войдёт через участника шага.'}"
                       IsVisible="{Binding !CanAddCharacter}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanAddCharacter}">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding CharacterOptions}"
                        SelectedItem="{Binding SelectedCharacterOption, Mode=TwoWay}"
                        PlaceholderText="{loc:Tr 'Персонаж'}" ToolTip.Tip="{loc:Tr 'Персонаж проекта'}" />
              <Button Grid.Column="1" Classes="tool" Margin="6,0,0,0"
                      Command="{Binding AddCharacterCommand}" ToolTip.Tip="{loc:Tr 'Добавить персонажа в сцену'}">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" />
              </Button>
            </Grid>
          </StackPanel>

          <!-- Заметки -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'ЗАМЕТКИ'}" />
            <Border Classes="panelField">
            <TextBox Classes="panelField" Text="{Binding Notes, Mode=TwoWay}" MinHeight="60" PlaceholderText="{loc:Tr 'Заметки по сцене…'}" />
          </Border>
          </StackPanel>

          <!-- Действия -->
          <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding UpdateMetaCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Сохранить'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding OpenPlannerCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Открыть в планировщике'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
