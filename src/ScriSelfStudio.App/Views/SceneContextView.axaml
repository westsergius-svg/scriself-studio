<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:shell="clr-namespace:ScriSelfStudio.App.Shell"
             xmlns:model="clr-namespace:ScriSelfStudio.Core.Model;assembly=ScriSelfStudio.Core"
             xmlns:dto="using:ScriSelfStudio.Contracts.Dtos"
             xmlns:profile="using:ScriSelfStudio.Presentation.Characters"
             x:Class="ScriSelfStudio.App.Views.SceneContextView" x:Name="SceneContextRoot"
             x:DataType="shell:SceneContextViewModel"
             Classes.studio="{Binding $parent[Window].((shell:ShellViewModel)DataContext).IsStudioTheme}">
  <UserControl.Styles>
    <Style Selector="TextBlock.panelLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBox.panelField">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="AcceptsReturn" Value="True" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource PaperTextBrush}" />
    </Style>
    <Style Selector="Border.panelField">
      <Setter Property="Background" Value="{DynamicResource SurfaceFieldBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>
    <Style Selector="Border.panelChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
    </Style>
    <Style Selector="Button.panelChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
    <Style Selector=":is(UserControl).studio TextBox.panelField">
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector=":is(UserControl).studio Border.panelField">
      <Setter Property="CornerRadius" Value="3" /><Setter Property="Padding" Value="10" />
      <Setter Property="BorderThickness" Value="1" /><Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
    </Style>
    <Style Selector=":is(UserControl).studio Button.panelChip">
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector=":is(UserControl).studio Border.panelChip">
      <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector=":is(UserControl).studio Border.sceneLabel"><Setter Property="IsVisible" Value="False" /></Style>
    <Style Selector=":is(UserControl).studio StackPanel.sceneContextBody"><Setter Property="Spacing" Value="20" /></Style>
  </UserControl.Styles>

  <Border Classes="sceneContextSurface" Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1,0,0,0">
    <DockPanel>
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceChromeBrush}" BorderBrush="{DynamicResource ChromeBorderBrush}"
            BorderThickness="0,0,0,1" Padding="14,10"
            IsVisible="{Binding $parent[Window].((shell:ShellViewModel)DataContext).IsStudioTheme}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{loc:Tr 'Контекст сцены'}" FontSize="12" FontWeight="SemiBold" />
        <Button Grid.Column="1" Classes="treeCollapse" Command="{Binding $parent[Window].((shell:ShellViewModel)DataContext).ToggleScenePanelCommand}"
                AutomationProperties.Name="{loc:Tr 'Контекст сцены'}" ToolTip.Tip="{loc:Tr 'Контекст сцены (Ctrl+Shift+I)'}">
          <Path Data="M4,4 L8,8 L4,12 M9,4 L13,8 L9,12" Width="16" Height="16" Stroke="{DynamicResource SidebarSubTextBrush}" StrokeThickness="1.5" />
        </Button>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Bottom" x:Name="SceneContextActions" Margin="16,8,16,12" Spacing="8" IsVisible="{Binding HasScene}">
      <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Command="{Binding UpdateMetaCommand}">
        <TextBlock Text="{loc:Tr 'Сохранить контекст сцены'}" TextWrapping="Wrap" TextAlignment="Center" />
      </Button>
      <Button Classes="tool" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
              Command="{Binding OpenPlannerCommand}">
        <TextBlock Text="{loc:Tr 'Открыть в планировщике'}" TextWrapping="Wrap" TextAlignment="Center" />
      </Button>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <TextBlock Margin="16" Classes="muted" Text="{loc:Tr 'Сцена не открыта.'}" IsVisible="{Binding !HasScene}" />

        <StackPanel Classes="sceneContextBody" Margin="16" Spacing="14" IsVisible="{Binding HasScene}">
          <!-- Заголовок панели -->
          <StackPanel Spacing="6">
            <Border Classes="panelChip sceneLabel" HorizontalAlignment="Left">
              <TextBlock Text="{loc:Tr 'Сцена'}" FontSize="11" FontWeight="SemiBold"
                         Foreground="{DynamicResource ActiveAccentBrush}" />
            </Border>
            <TextBlock Classes="cardHeading" Text="{Binding SceneTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="muted" Text="{Binding Breadcrumb}" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Ошибка сохранения -->
          <Border Background="{DynamicResource DangerFillBrush}" CornerRadius="8" Padding="10"
                  IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource DangerTextBrush}" />
          </Border>

          <!-- Кратко -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'КРАТКО'}" />
            <Border Classes="panelField">
            <TextBox Classes="panelField" Text="{Binding Summary, Mode=TwoWay}" MinHeight="70" PlaceholderText="{loc:Tr 'О чём сцена…'}" />
          </Border>
          </StackPanel>

          <!-- Статус -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'СТАТУС'}" />
            <WrapPanel>
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusIdea}" Content="{loc:Tr 'Идея'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Idea}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusDraft}" Content="{loc:Tr 'Черновик'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Draft}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusRevised}" Content="{loc:Tr 'В работе'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Revised}" />
              <Button Classes="statusBtn" Classes.active="{Binding IsStatusFinal}" Content="{loc:Tr 'Готово'}" Margin="0,0,6,6"
                      Command="{Binding SetStatusCommand}" CommandParameter="{x:Static model:SceneStatus.Final}" />
            </WrapPanel>
          </StackPanel>

          <!-- Ключевые сюжетные линии -->
          <StackPanel Spacing="8">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'КЛЮЧЕВЫЕ СЮЖЕТНЫЕ ЛИНИИ'}" />
            <ItemsControl ItemsSource="{Binding AssignedSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:SceneStepEntry">
                  <StackPanel Spacing="4" Margin="0,0,0,5">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="panelChip descriptionToggle" Grid.Column="0"
                              Command="{Binding ToggleDescriptionCommand}"
                              ToolTip.Tip="{loc:Tr 'Показать описание этапа'}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                          <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{Binding Brush}" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                      <Button Classes="removeIcon" Grid.Column="1" Margin="4,0,0,0" VerticalAlignment="Top"
                              Command="{Binding RemoveCommand}" ToolTip.Tip="{loc:Tr 'Снять шаг со сцены'}"
                              AutomationProperties.Name="{loc:Tr 'Снять шаг со сцены'}">
                        <PathIcon Data="{StaticResource RemoveIconGeometry}" Width="14" Height="14" />
                      </Button>
                    </Grid>
                    <WrapPanel>
                      <Button Classes="tool" MinWidth="58" Margin="0,0,4,0" Content="{loc:Tr 'Выше'}" MinHeight="32"
                              Command="{Binding #SceneContextRoot.((shell:SceneContextViewModel)DataContext).MoveStepUpCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveUp}" />
                      <Button Classes="tool" MinWidth="58" Margin="0,0,4,0" Content="{loc:Tr 'Ниже'}" MinHeight="32"
                              Command="{Binding #SceneContextRoot.((shell:SceneContextViewModel)DataContext).MoveStepDownCommand}" CommandParameter="{Binding}" IsEnabled="{Binding CanMoveDown}" />
                    </WrapPanel>
                    <StackPanel Margin="8,0,4,4" Spacing="3"
                                IsVisible="{Binding IsDescriptionExpanded}">
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding StepHeading}" />
                      <TextBlock Text="{Binding StepDescriptionText}" FontSize="12" TextWrapping="Wrap" />
                      <StackPanel IsVisible="{Binding HasLineDescription}" Spacing="2">
                        <TextBlock Classes="muted" FontSize="10" Text="{Binding LineHeading}" />
                        <TextBlock Text="{Binding LineDescription}" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Сцена не привязана к шагам линий. Выберите линию и шаг ниже.'}"
                       IsVisible="{Binding !HasAssignedSteps}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'У проекта нет линий с шагами. Создайте линию на экране «Сюжетные линии».'}"
                       IsVisible="{Binding !HasLineOptions}" />

            <StackPanel Spacing="6" IsVisible="{Binding HasLineOptions}">
              <ComboBox HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding LineOptions}"
                        SelectedItem="{Binding SelectedLineOption, Mode=TwoWay}"
                        ToolTip.Tip="{loc:Tr 'Сюжетная линия'}" />
              <ComboBox HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding StepOptions}"
                        SelectedItem="{Binding SelectedStepOption, Mode=TwoWay}"
                        IsVisible="{Binding HasStepOptions}"
                        ToolTip.Tip="{loc:Tr 'Шаг линии'}" />
              <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Command="{Binding AddStepCommand}" IsEnabled="{Binding CanAddStep}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                  <TextBlock Text="{loc:Tr 'Добавить шаг'}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- Персонажи -->
          <StackPanel Spacing="8">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'ПЕРСОНАЖИ'}" />
            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Персонажи не упомянуты. Добавьте участника шага, привязанного к сцене.'}"
                       IsVisible="{Binding !HasCharacters}" />
            <ItemsControl ItemsSource="{Binding Characters}" IsVisible="{Binding HasCharacters}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:CharacterEntry">
                  <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                    <Border Classes="avatar" Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top">
                      <TextBlock Classes="avatarLetter" FontSize="16" Text="{Binding Initial}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="4" Margin="10,0,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Classes="muted" Text="{Binding RoleLabel}" VerticalAlignment="Center" />
                      </StackPanel>
                      <Button Classes="panelChip descriptionToggle" HorizontalAlignment="Left"
                              IsVisible="{Binding HasStep}" Command="{Binding ToggleDescriptionCommand}"
                              ToolTip.Tip="{loc:Tr 'Показать описание этапа'}">
                        <TextBlock Text="{Binding StepLabel}" FontSize="11" />
                      </Button>
                      <ItemsControl ItemsSource="{Binding ArcStages}" IsVisible="{Binding IsDescriptionExpanded}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="dto:CharacterArcStageDto">
                            <StackPanel Spacing="4" Margin="0,4,0,8">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Button Classes="panelChip descriptionToggle" IsVisible="{Binding HasProfile}"
                              Command="{Binding ToggleProfileCommand}" HorizontalAlignment="Stretch">
                        <TextBlock Text="{loc:Tr 'Характеристика персонажа'}" TextWrapping="Wrap" FontSize="12" />
                      </Button>
                        <ItemsControl ItemsSource="{Binding Profile}" IsVisible="{Binding IsProfileExpanded}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="profile:CharacterProfileField">
                              <StackPanel Spacing="4" Margin="0,4,0,8">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                       Text="{loc:Tr 'Сначала привяжите сцену к шагу линии — персонаж войдёт через участника шага.'}"
                       IsVisible="{Binding !CanAddCharacter}" />
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanAddCharacter}">
              <ComboBox Grid.Column="0" HorizontalAlignment="Stretch" MinHeight="32"
                        ItemsSource="{Binding CharacterOptions}"
                        SelectedItem="{Binding SelectedCharacterOption, Mode=TwoWay}"
                        PlaceholderText="{loc:Tr 'Персонаж'}" ToolTip.Tip="{loc:Tr 'Персонаж проекта'}" />
              <Button Grid.Column="1" Classes="tool" Margin="6,0,0,0"
                      Command="{Binding AddCharacterCommand}" ToolTip.Tip="{loc:Tr 'Добавить персонажа в сцену'}">
                <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE710;" FontSize="12" />
              </Button>
            </Grid>
          </StackPanel>

          <!-- Заметки -->
          <StackPanel Spacing="6">
            <TextBlock Classes="panelLabel" Text="{loc:Tr 'ЗАМЕТКИ'}" />
            <Border Classes="panelField">
            <TextBox Classes="panelField" Text="{Binding Notes, Mode=TwoWay}" MinHeight="60" PlaceholderText="{loc:Tr 'Заметки по сцене…'}" />
          </Border>
          </StackPanel>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
