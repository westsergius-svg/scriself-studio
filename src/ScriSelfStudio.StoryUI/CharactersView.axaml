<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:story="clr-namespace:ScriSelfStudio.StoryUI"
             x:Class="ScriSelfStudio.StoryUI.CharactersView"
             x:DataType="story:CharactersViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <!-- Верхняя строка: действия (название вкладки даёт хост Архитектора). -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{loc:Tr 'Удалить'}" Command="{Binding DeleteCharacterCommand}" IsVisible="{Binding HasSelection}" Padding="12,6" Foreground="#991B1B" />
        <Button Content="{loc:Tr 'Сохранить персонажа'}" Command="{Binding SaveCharacterCommand}" Padding="16,6" Background="#4F6D46" Foreground="White" FontWeight="Bold" />
      </StackPanel>
    </Grid>

    <!-- Главный трёхколоночный контент -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*,300">
      
      <!-- 1. ЛЕВАЯ ПАНЕЛЬ: ПОИСК И СПИСОК ПЕРСОНАЖЕЙ -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="14" Margin="0,0,16,0">
        <DockPanel>
          <!-- Добавить персонажа -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="{loc:Tr 'Персонажи'}" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="{loc:Tr '+ Добавить'}" Command="{Binding NewCharacterCommand}" Height="34" Padding="10,0" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" />
          </Grid>

          <!-- Список -->
          <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerTheme>
              <ControlTheme TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                  <ControlTemplate>
                    <Border Name="Root" CornerRadius="10" Padding="8,8" Background="{TemplateBinding Background}">
                      <ContentPresenter Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                  </ControlTemplate>
                </Setter>
              </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="story:CharacterListItem">
                <Border CornerRadius="10" Padding="8,8" Margin="0,2" Background="Transparent">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#7A6857" Margin="0,0,10,0">
                      <TextBlock Text="👤" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource HeadingBrush}" />
                      <TextBlock Text="{Binding RoleLabel}" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                    </StackPanel>
                    <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" Padding="6,2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                 Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 2. ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: ДЕТАЛИ ПЕРСОНАЖАИ ТАБЫ -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,16,0">
          <StackPanel Spacing="16">
            
            <!-- Карточка шапки персонажа (Аватар + Имя + Роль + Теги) -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Background="#5B4A3E" Margin="0,0,16,0">
                <TextBlock Text="👤" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding Draft.Name, Mode=TwoWay}" FontSize="20" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource HeadingBrush}" PlaceholderText="{loc:Tr 'Имя персонажа...'}" Width="320" />
                  <Border Padding="8,3" CornerRadius="8" Background="#E9F3EA">
                    <TextBlock Text="{Binding Draft.Status.Label}" FontSize="11" Foreground="#2F6C44" FontWeight="SemiBold" />
                  </Border>
                </StackPanel>
                <ComboBox ItemsSource="{Binding Roles}"
                          SelectedItem="{Binding Draft.Role, Mode=TwoWay}"
                          PlaceholderText="{loc:Tr 'Роль персонажа...'}"
                          Width="240"
                          Height="30"
                          HorizontalAlignment="Left" />
                <TextBlock Text="{Binding Draft.Importance.Label}"
                           FontSize="11"
                           Foreground="{DynamicResource SidebarSubTextBrush}" />
              </StackPanel>
            </Grid>

            <TabControl TabStripPlacement="Top" Background="Transparent" BorderThickness="0">
              
              <!-- Таб 1: Основное -->
              <TabItem Header="{loc:Tr 'Основное'}">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                  <!-- Описание -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Описание'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Description, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Никнейм'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.Nickname, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Возраст'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.Age, Mode=TwoWay}" PlaceholderText="{loc:Tr '25 лет'}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Пол'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.Gender, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Вид / раса'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.Species, Mode=TwoWay}" PlaceholderText="{loc:Tr 'Человек, эльф, маг...'}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Занятие'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.Occupation, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Мир'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.World, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Теги'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <TextBox Text="{Binding Draft.TagsText, Mode=TwoWay}" PlaceholderText="{loc:Tr 'маг, предатель, союзник'}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Важность'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <ComboBox ItemsSource="{Binding Importances}" SelectedItem="{Binding Draft.Importance, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6">
                      <TextBlock Text="{loc:Tr 'Статус'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                      <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Draft.Status, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Grid>

                  <!-- Характер бейджи -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Характер'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Temperament, Mode=TwoWay}"
                             PlaceholderText="{loc:Tr 'Например: спокойный, рассудительный, целеустремлённый'}"
                             CornerRadius="8"
                             Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Внешность -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Внешность'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Appearance, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Главная цель -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Главная цель'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.ExternalGoal, Mode=TwoWay}" PlaceholderText="{loc:Tr 'Найти источник магии.'}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Главный страх -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Главный страх'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Fears, Mode=TwoWay}" PlaceholderText="{loc:Tr 'Потерять близких.'}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Арка персонажа (Путь героя) -->
                  <Border Background="{DynamicResource SurfaceCanvasBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr 'Арка персонажа'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                        <Button Grid.Column="1"
                                Content="{loc:Tr '＋ Добавить шаг'}"
                                Command="{Binding AddArcStageCommand}"
                                Padding="10,4"
                                CornerRadius="8"
                                Background="{DynamicResource SurfaceHoverBrush}"
                                Foreground="{DynamicResource SidebarTextBrush}" />
                      </Grid>

                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Grid.Column="0" Spacing="6">
                          <TextBlock Text="{loc:Tr 'Тип арки'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                          <ComboBox ItemsSource="{Binding ArcTypes}" SelectedItem="{Binding Draft.ArcType, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <TextBlock Text="{loc:Tr 'Статус карточки'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                          <ComboBox ItemsSource="{Binding DraftStatuses}" SelectedItem="{Binding Draft.DraftStatus, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                      </Grid>

                      <StackPanel Spacing="6">
                        <TextBlock Text="{loc:Tr 'Краткое описание арки'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                        <TextBox Text="{Binding Draft.ArcSummary, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 CornerRadius="6"
                                 Background="{DynamicResource SurfaceFieldBrush}" />
                      </StackPanel>

                      <ItemsControl ItemsSource="{Binding Draft.ArcStages}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="story:ArcStageDraft">
                            <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Grid.Column="0" Width="8" Height="8" CornerRadius="4" Background="#5B7BB2" VerticalAlignment="Center" Margin="2,0,0,0" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                  <TextBox Text="{Binding Title, Mode=TwoWay}" BorderThickness="0" Background="Transparent" FontWeight="SemiBold" Foreground="{DynamicResource HeadingBrush}" />
                                  <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.ArcStageKinds}"
                                            SelectedItem="{Binding Kind, Mode=TwoWay}"
                                            MinWidth="180"
                                            Height="28"
                                            FontSize="12" />
                                  <TextBox Text="{Binding Description, Mode=TwoWay}"
                                            PlaceholderText="{loc:Tr 'Описание этапа…'}"
                                            AcceptsReturn="True"
                                            TextWrapping="Wrap"
                                            MinHeight="48"
                                            FontSize="12"
                                            CornerRadius="6"
                                            Background="{DynamicResource SurfaceCanvasBrush}"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}" />
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Content="✕"
                                        Command="{Binding $parent[UserControl].DataContext.RemoveArcStageCommand}"
                                        CommandParameter="{Binding}"
                                        Width="28"
                                        Height="28"
                                        CornerRadius="14"
                                        Background="Transparent"
                                        Foreground="{DynamicResource SidebarSubTextBrush}" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <!-- Таб 2: Цели и страхи -->
              <TabItem Header="{loc:Tr 'Цели'}">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="{loc:Tr 'Мотивация'}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.Motivation, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:Tr 'Ложь (в чём ошибается)'}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.FalseBelief, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                  <TextBlock Text="{loc:Tr 'Потребность'}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.InternalNeed, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

              <!-- Таб 3: Связи -->
              <TabItem Header="{loc:Tr 'Связи'}">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr 'Связанные персонажи'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="{loc:Tr '＋ Добавить связь'}" Command="{Binding AddRelationCommand}"
                            Padding="10,4" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" />
                  </Grid>
                  <ListBox ItemsSource="{Binding Draft.Relations}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="story:RelationDraft">
                        <StackPanel Spacing="6" Margin="0,4">
                          <Grid ColumnDefinitions="160,140,*,Auto" ColumnSpacing="8">
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableCharacters}" SelectedItem="{Binding Character, Mode=TwoWay}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding $parent[UserControl].DataContext.RelationTypes}" SelectedItem="{Binding Type, Mode=TwoWay}" />
                            <TextBox Grid.Column="2" Text="{Binding Dynamic, Mode=TwoWay}" PlaceholderText="{loc:Tr 'Динамика отношений'}" />
                            <Button Grid.Column="3" Content="✕" Width="30" Height="30" CornerRadius="15"
                                    Background="Transparent" Foreground="{DynamicResource SidebarSubTextBrush}"
                                    Command="{Binding $parent[UserControl].DataContext.RemoveRelationCommand}"
                                    CommandParameter="{Binding}" />
                          </Grid>
                          <TextBox Text="{Binding Status, Mode=TwoWay}" PlaceholderText="{loc:Tr 'Статус связи'}" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </TabItem>

              <!-- Таб 4: Линии -->
              <TabItem Header="{loc:Tr 'Линии'}">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="{loc:Tr 'Участие в сюжетных линиях'}" FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding Participation}" />
                </StackPanel>
              </TabItem>

              <!-- Таб 5: Сцены -->
              <TabItem Header="{loc:Tr 'Сцены'}">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="{loc:Tr 'Заметки для сцен'}" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.SceneIdeas, Mode=TwoWay}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

              <!-- Полная карточка: все поля, включая разделы 2–13 из ТЗ. -->
              <TabItem Header="{loc:Tr 'Все поля'}">
                <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Sections}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="story:CardSection">
                        <Expander Header="{Binding Title}" IsExpanded="False" Margin="0,0,0,8">
                          <ItemsControl ItemsSource="{Binding Fields}" Margin="8,8,0,0">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="story:CardField">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                  <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                                  <TextBox Text="{Binding Value, Mode=TwoWay}"
                                           AcceptsReturn="{Binding Multiline}"
                                           TextWrapping="Wrap"
                                           MinHeight="{Binding MinHeight}"
                                           CornerRadius="6"
                                           Background="{DynamicResource SurfaceFieldBrush}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </Expander>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </TabItem>

            </TabControl>

          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- 3. ПРАВАЯ ПАНЕЛЬ: СВЯЗИ, ЛИНИИ И ПРИСУТСТВИЕ В СЦЕНАХ (данные проекта) -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="18">
            <!-- Связанные персонажи -->
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr 'Связанные персонажи'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
              <TextBlock Text="{loc:Tr 'Связи не заданы.'}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource SidebarSubTextBrush}"
                         IsVisible="{Binding !HasRelatedCharacters}" />
              <ItemsControl ItemsSource="{Binding RelatedCharacters}" IsVisible="{Binding HasRelatedCharacters}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="story:RelatedCharacterEntry">
                    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
                      <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="{Binding Brush}" Margin="0,0,8,0">
                        <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding RelationLabel}" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

            <!-- Связанные линии -->
            <StackPanel Spacing="10">
              <TextBlock Text="{loc:Tr 'Связанные линии'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
              <TextBlock Text="{loc:Tr 'Персонаж пока не участвует в линиях.'}" FontSize="12" TextWrapping="Wrap"
                         Foreground="{DynamicResource SidebarSubTextBrush}"
                         IsVisible="{Binding !HasRelatedLines}" />
              <ItemsControl ItemsSource="{Binding RelatedLines}" IsVisible="{Binding HasRelatedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="story:RelatedLineEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                      <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{DynamicResource SidebarSubTextBrush}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

            <!-- Присутствие в сценах -->
            <StackPanel Spacing="6">
              <TextBlock Text="{loc:Tr 'Присутствие в сценах'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
              <TextBlock Text="{Binding SceneCountLabel}" FontSize="13" FontWeight="Bold"
                         Foreground="{DynamicResource SidebarTextBrush}" />
              <TextBlock Text="{loc:Tr 'Сцены появятся, когда персонаж войдёт в шаги сюжетных линий.'}"
                         FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SidebarSubTextBrush}"
                         IsVisible="{Binding !HasScenePresence}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>    </Grid>
  </Grid>
</UserControl>
