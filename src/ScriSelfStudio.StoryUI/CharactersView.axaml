<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:story="clr-namespace:ScriSelfStudio.StoryUI"
             x:Class="ScriSelfStudio.StoryUI.CharactersView"
             x:DataType="story:CharactersViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <!-- Верхняя строка: действия (название вкладки даёт хост Архитектора). -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="Удалить" Command="{Binding DeleteCharacterCommand}" IsVisible="{Binding HasSelection}" Padding="12,6" Foreground="#991B1B" />
        <Button Content="Сохранить персонажа" Command="{Binding SaveCharacterCommand}" Padding="16,6" Background="#4F6D46" Foreground="White" FontWeight="Bold" />
      </StackPanel>
    </Grid>

    <!-- Главный трёхколоночный контент -->
    <Grid Grid.Row="1" ColumnDefinitions="280,*,300">
      
      <!-- 1. ЛЕВАЯ ПАНЕЛЬ: ПОИСК И СПИСОК ПЕРСОНАЖЕЙ -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="14" Margin="0,0,16,0">
        <DockPanel>
          <!-- Поиск и Добавить -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <TextBox Grid.Column="0" Watermark="Поиск персонажей..." Height="34" Margin="0,0,8,0" CornerRadius="8" />
            <Button Grid.Column="1" Content="+ Добавить" Command="{Binding NewCharacterCommand}" Height="34" Padding="10,0" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" />
          </Grid>

          <!-- Фильтры -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,*" Margin="0,0,0,12">
            <ComboBox Grid.Column="0" PlaceholderText="Все роли" ItemsSource="{Binding Roles}" Margin="0,0,4,0" HorizontalAlignment="Stretch" Height="32" />
            <ComboBox Grid.Column="1" PlaceholderText="Все арки" ItemsSource="{Binding ArcTypes}" Margin="4,0,0,0" HorizontalAlignment="Stretch" Height="32" />
          </Grid>

          <!-- Список -->
          <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                   Background="Transparent" BorderThickness="0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="story:CharacterListItem">
                <Border CornerRadius="10" Padding="8,8" Margin="0,2">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- Аватар кружок -->
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#7A6857" Margin="0,0,10,0">
                      <TextBlock Text="👤" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- Имя и роль -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource HeadingBrush}" />
                      <TextBlock Text="{Binding RoleLabel}" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                    </StackPanel>
                    <!-- Статус бейдж -->
                    <Border Grid.Column="2" CornerRadius="8" Background="#ECFDF5" Padding="6,2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="4">
                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                        <TextBlock Text="Активен" FontSize="10" Foreground="#065F46" VerticalAlignment="Center" />
                      </StackPanel>
                    </Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- 2. ЦЕНТРАЛЬНАЯ ПАНЕЛЬ: ДЕТАЛИ ПЕРСОНАЖАИ ТАБЫ -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="20" Margin="0,0,16,0">
          <StackPanel Spacing="16">
            
            <!-- Карточка шапки персонажа (Аватар + Имя + Роль + Теги) -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,8">
              <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36" Background="#5B4A3E" Margin="0,0,16,0">
                <TextBlock Text="👤" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Text="{Binding Draft.Name, Mode=TwoWay}" FontSize="20" FontWeight="Bold" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource HeadingBrush}" Watermark="Имя персонажа..." />
                  <TextBlock Text="✏️" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource SidebarSubTextBrush}" />
                </StackPanel>
                <TextBox Text="{Binding Draft.Role, Mode=TwoWay}" FontSize="13" Foreground="{DynamicResource SidebarSubTextBrush}" BorderThickness="0" Background="Transparent" Watermark="Роль персонажа..." />
                
                <!-- Теги -->
                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                  <Border Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="8,2" Margin="0,0,6,0">
                    <TextBlock Text="Маг • 26 лет" FontSize="11" Foreground="{DynamicResource SidebarTextBrush}" />
                  </Border>
                </WrapPanel>
              </StackPanel>
            </Grid>

            <!-- Вкладки (Табы) -->
            <TabControl TabStripPlacement="Top">
              
              <!-- Таб 1: Основное -->
              <TabItem Header="Основное">
                <StackPanel Spacing="16" Margin="0,16,0,0">
                  <!-- Описание -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Описание" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Description, Mode=TwoWay}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Характер бейджи -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Характер" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <WrapPanel Orientation="Horizontal">
                      <Border Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                        <TextBlock Text="Спокойный" FontSize="12" />
                      </Border>
                      <Border Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                        <TextBlock Text="Рассудительный" FontSize="12" />
                      </Border>
                      <Border Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                        <TextBlock Text="Целеустремлённый" FontSize="12" />
                      </Border>
                      <Border Background="{DynamicResource SurfaceFieldBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="0,0,6,6">
                        <TextBlock Text="Верный" FontSize="12" />
                      </Border>
                    </WrapPanel>
                  </StackPanel>

                  <!-- Внешность -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Внешность" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Appearance, Mode=TwoWay}" CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Главная цель -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Главная цель" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.ExternalGoal, Mode=TwoWay}" Watermark="Найти источник магии." CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Главный страх -->
                  <StackPanel Spacing="6">
                    <TextBlock Text="Главный страх" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                    <TextBox Text="{Binding Draft.Fears, Mode=TwoWay}" Watermark="Потерять близких." CornerRadius="8" Background="{DynamicResource SurfaceFieldBrush}" />
                  </StackPanel>

                  <!-- Арка персонажа (Путь героя) -->
                  <Border Background="{DynamicResource SurfaceCanvasBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <StackPanel Spacing="10">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Арка персонажа" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
                        <TextBlock Grid.Column="1" Text="● Путь героя" FontSize="12" Foreground="#4F6D46" FontWeight="SemiBold" />
                      </Grid>

                      <!-- Шкала прогресса арки -->
                      <ProgressBar Value="70" Maximum="100" Height="6" CornerRadius="3" Background="{DynamicResource SurfaceBorderBrush}" Foreground="#5B7BB2" />

                      <Grid ColumnDefinitions="*,*,*,*">
                        <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                          <TextBlock Text="Начало" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                          <TextBlock Text="5%" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                          <TextBlock Text="Испытание" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                          <TextBlock Text="40%" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                          <TextBlock Text="Преодоление" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                          <TextBlock Text="70%" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                          <TextBlock Text="Счастье" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                          <TextBlock Text="100%" FontSize="12" FontWeight="Bold" />
                        </StackPanel>
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </TabItem>

              <!-- Таб 2: Цели и страхи -->
              <TabItem Header="Цели и страхи">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="Мотивация" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.Motivation, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                  <TextBlock Text="Ложь (в чём ошибается)" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.FalseBelief, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                  <TextBlock Text="Потребность" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.InternalNeed, Mode=TwoWay}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

              <!-- Таб 3: Связи -->
              <TabItem Header="Связи">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="Связанные персонажи" FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding Draft.Relations}">
                    <ListBox.ItemTemplate>
                      <DataTemplate DataType="story:RelationDraft">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ComboBox ItemsSource="{Binding AvailableCharacters}" SelectedItem="{Binding Character}" Width="160" />
                          <ComboBox ItemsSource="{Binding $parent[UserControl].DataContext.RelationTypes}" SelectedItem="{Binding Type}" Width="140" />
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </TabItem>

              <!-- Таб 4: Линии -->
              <TabItem Header="Линии">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="Участие в сюжетных линиях" FontWeight="SemiBold" />
                  <ListBox ItemsSource="{Binding Participation}" />
                </StackPanel>
              </TabItem>

              <!-- Таб 5: Сцены -->
              <TabItem Header="Сцены">
                <StackPanel Spacing="12" Margin="0,16,0,0">
                  <TextBlock Text="Заметки для сцен" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Draft.SceneIdeas, Mode=TwoWay}" AcceptsReturn="True" MinHeight="100" TextWrapping="Wrap" />
                </StackPanel>
              </TabItem>

            </TabControl>

          </StackPanel>
        </Border>
      </ScrollViewer>

      <!-- 3. ПРАВАЯ ПАНЕЛЬ: СВЯЗАННЫЕ ПЕРСОНАЖИ, ЛИНИИ И ПРИСУТСТВИЕ В СЦЕНАХ -->
      <Border Grid.Column="2" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="16">
        <StackPanel Spacing="18">
          <!-- Связанные персонажи -->
          <StackPanel Spacing="10">
            <TextBlock Text="Связанные персонажи" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#8C6D58" Margin="0,0,8,0">
                  <TextBlock Text="👤" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Лея" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="Поддерживает" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Foreground="{DynamicResource SidebarSubTextBrush}" />
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#4A5568" Margin="0,0,8,0">
                  <TextBlock Text="👤" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Кай" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="Противник" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Foreground="{DynamicResource SidebarSubTextBrush}" />
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#718096" Margin="0,0,8,0">
                  <TextBlock Text="👤" Foreground="White" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="Селена" FontWeight="SemiBold" FontSize="12" />
                  <TextBlock Text="Союзник" FontSize="11" Foreground="{DynamicResource SidebarSubTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" Foreground="{DynamicResource SidebarSubTextBrush}" />
              </Grid>
            </StackPanel>
            <Button Content="Показать всех (4) ˅" Background="Transparent" Foreground="{DynamicResource SidebarSubTextBrush}" FontSize="12" Padding="0,4" HorizontalAlignment="Left" />
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

          <!-- Связанные линии -->
          <StackPanel Spacing="10">
            <TextBlock Text="Связанные линии" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#4A7DFF" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Основная линия" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                  <TextBlock Text="Открыта" FontSize="10" Foreground="#065F46" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#D946EF" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Любовная линия" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center" />
                  <TextBlock Text="Открыта" FontSize="10" Foreground="#065F46" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="2" Background="#8B5CF6" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Линия предательства" FontSize="12" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Ellipse Width="6" Height="6" Fill="#F59E0B" VerticalAlignment="Center" />
                  <TextBlock Text="Частично" FontSize="10" Foreground="#92400E" />
                </StackPanel>
              </Grid>
            </StackPanel>
          </StackPanel>

          <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

          <!-- Присутствие в сценах -->
          <StackPanel Spacing="6">
            <TextBlock Text="Присутствие в сценах" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextBrush}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="12 сцен" FontSize="13" FontWeight="Bold" />
              <TextBlock Grid.Column="1" Text="→" FontSize="14" Foreground="{DynamicResource SidebarSubTextBrush}" />
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
