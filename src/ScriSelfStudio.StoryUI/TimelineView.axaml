<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:story="clr-namespace:ScriSelfStudio.StoryUI"
             x:Class="ScriSelfStudio.StoryUI.TimelineView"
             x:DataType="story:TimelineViewModel"
             Background="{DynamicResource SurfaceCanvasBrush}">
  <UserControl.Styles>
    <!-- Заголовки и подписи макета: заголовки панелей — антиква, как в остальном приложении. -->
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style Selector="TextBlock.lineHeading">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionCaps">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
    </Style>
    <Style Selector="TextBlock.stepTitle">
      <Setter Property="FontFamily" Value="Georgia" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stepText">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBox.fieldBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.outlineButton">
      <Setter Property="Background" Value="{DynamicResource SurfaceFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.outlineButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.dangerButton">
      <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="16,0" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.dangerButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.ghostIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghostIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.outlinePlus">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.outlinePlus:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBox.linesList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- У выбранного пункта разделитель не рисуется: его роль играет рамка макета. -->
    <Style Selector="ListBox.linesList > ListBoxItem:selected Rectangle.listSep">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.linesList TextBlock.lineName">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected TextBlock.lineName">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <Style Selector="Border.timelineDot">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="CornerRadius" Value="20" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconChip">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="24" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.stepCard">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.stepHead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.statusPill">
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Padding" Value="14,7" />
      <Setter Property="Background" Value="{DynamicResource StatusActiveFillBrush}" />
    </Style>

    <Style Selector="Border.swatchRing">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.swatchRing.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.swatchButton">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="320,*,400">
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceCanvasBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="16,16,16,16">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <TextBlock Grid.Column="0" Classes="panelTitle" Text="Линии" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="outlinePlus" Command="{Binding NewLineCommand}"
                  ToolTip.Tip="Новая линия">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" />
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,0,0,8"
                   Text="Пока пусто. Нажмите «+», чтобы создать линию."
                   IsVisible="{Binding !HasPlotLines}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ListBox Classes="linesList"
                   ItemsSource="{Binding PlotLines}"
                   SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="story:PlotLineListItem">
                <Grid RowDefinitions="*,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="4,Auto,*,Auto" Margin="0,12,0,12">
                    <Border Grid.Column="0" Width="4" CornerRadius="12,0,0,12"
                            Background="{DynamicResource DangerTextBrush}"
                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                    <Ellipse Grid.Column="1" Width="14" Height="14" Fill="{Binding Swatch}"
                             VerticalAlignment="Top" Margin="12,4,0,0" />
                    <StackPanel Grid.Column="2" Margin="10,0,6,0" Spacing="3">
                      <TextBlock Classes="lineName" Text="{Binding Name}" />
                      <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="ghostIcon" VerticalAlignment="Top"
                            Margin="0,0,0,0" ToolTip.Tip="Действия">
                      <TextBlock Text="•••" FontSize="11" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="Переименовать"
                                    Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).ToggleHeaderEditingCommand}" />
                          <MenuItem Header="Удалить линию"
                                    Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).DeleteLineByIdCommand}"
                                    CommandParameter="{Binding Id}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <Rectangle Grid.Row="1" Classes="listSep" Height="1" Margin="14,0,14,0"
                             Fill="{DynamicResource SurfaceBorderBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Центр: шапка линии и лента шагов (макет: крупный заголовок, «Шаги»). -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="28,22,28,28" Spacing="0">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Classes="success" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Classes="muted" Margin="0,0,0,10"
                   Text="Проект не открыт. Вернитесь на стартовый экран."
                   IsVisible="{Binding !HasProject}" />

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,18">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="13" Height="13" Fill="{Binding LineBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LineTitle}" FontSize="15" VerticalAlignment="Center"
                       TextDecorations="Underline"
                       Foreground="{DynamicResource SidebarSubTextBrush}" />
          </StackPanel>
          <Border Grid.Row="0" Grid.Column="1" Classes="statusPill">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Ellipse Width="10" Height="10" Fill="{Binding StatusDot}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusLabel}" FontSize="14" VerticalAlignment="Center"
                         Foreground="{DynamicResource StatusActiveTextBrush}" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="lineHeading" Text="{Binding LineHeading}"
                     Margin="0,6,24,0" />
          <Button Grid.Row="1" Grid.Column="1" Classes="outlineButton" VerticalAlignment="Top" Margin="0,10,0,0"
                  Command="{Binding ToggleHeaderEditingCommand}"
                  IsVisible="{Binding !IsHeaderEditing}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="Изменить" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="1" Classes="outlineButton" VerticalAlignment="Top" Margin="0,10,0,0"
                  Command="{Binding CommitLineCommand}"
                  IsVisible="{Binding IsHeaderEditing}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="Готово" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBox Grid.Row="2" Grid.ColumnSpan="2" Classes="fieldBox" Margin="0,10,0,0"
                   Text="{Binding Draft.Description, Mode=TwoWay}"
                   Watermark="Рабочее название линии"
                   IsVisible="{Binding IsHeaderEditing}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding GoalText}" FontSize="15" Margin="0,8,24,0"
                     Foreground="{DynamicResource SidebarSubTextBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding !IsHeaderEditing}" />
        </Grid>

        <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,18" />

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,16">
          <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="15" VerticalAlignment="Center"
                     Foreground="{DynamicResource SidebarTextBrush}" />
          <TextBlock Text="Шаги" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{DynamicResource HeadingBrush}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Draft.Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="story:StepDraft">
              <Grid ColumnDefinitions="52,*" Margin="0,0,0,10">
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                  <Border Classes="timelineDot" Background="{Binding AccentBrush}">
                    <TextBlock Text="{Binding NumberText}" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Grid Grid.Row="1" IsVisible="{Binding ShowConnector}" MinHeight="16">
                    <Rectangle Width="1.5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                               Fill="{DynamicResource SurfaceBorderBrush}" />
                    <TextBlock Text="&#x25BE;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource SidebarSubTextBrush}" />
                  </Grid>
                </Grid>

                <Border Grid.Column="1" Classes="stepCard" Background="{Binding FillBrush}">
                  <Grid ColumnDefinitions="6,*">
                    <Rectangle Grid.Column="0" Fill="{Binding AccentBrush}" />
                    <StackPanel Grid.Column="1" Spacing="0">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Classes="stepHead"
                                Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).ToggleStepCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="Раскрыть или свернуть шаг">
                          <Grid ColumnDefinitions="Auto,*" Margin="14,14,8,14">
                            <Border Grid.Column="0" Classes="iconChip">
                              <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding IconGlyph}" FontSize="17"
                                         Foreground="{Binding AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="4" VerticalAlignment="Center">
                              <TextBlock Classes="stepTitle" Text="{Binding Header}" />
                              <TextBlock Classes="stepText" Text="{Binding Description}"
                                         IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="ghostIcon" Margin="0,12,12,0" VerticalAlignment="Top"
                                ToolTip.Tip="Действия шага">
                          <TextBlock Text="•••" FontSize="11" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="Выше"
                                        Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).MoveStepUpCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Ниже"
                                        Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).MoveStepDownCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Финальный шаг"
                                        Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).ToggleFinalCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="Удалить шаг"
                                        Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).RemoveStepCommand}"
                                        CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>

                      <StackPanel Margin="20,0,20,18" Spacing="12" IsVisible="{Binding IsExpanded}">
                        <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" />
                        <TextBlock Classes="fieldLabel" Text="Название" />
                        <TextBox Classes="fieldBox" Text="{Binding Title, Mode=TwoWay}" />
                        <TextBlock Classes="fieldLabel" Text="Описание" />
                        <TextBox Classes="fieldBox" Text="{Binding Description, Mode=TwoWay}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
                        <TextBlock Classes="fieldLabel" Text="Значок шага" />
                        <ComboBox HorizontalAlignment="Stretch" MinHeight="42"
                                  ItemsSource="{Binding IconChoices}"
                                  SelectedItem="{Binding SelectedIcon, Mode=TwoWay}" />
                        <TextBlock Classes="sectionCaps" Text="ПЕРСОНАЖИ И ЭТАПЫ АРКИ" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Participants}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="story:StepParticipantDraft">
                              <Border Background="{DynamicResource SurfaceCardBrush}"
                                      BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                                      CornerRadius="9" Padding="10" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                  <ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding Characters}"
                                            SelectedItem="{Binding Character, Mode=TwoWay}" />
                                  <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                            ItemsSource="{Binding AvailableSteps}"
                                            SelectedItem="{Binding ArcStage, Mode=TwoWay}" PlaceholderText="этап арки" />
                                  <Button Grid.Column="2" Classes="ghostIcon"
                                          Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).RemoveParticipantCommand}"
                                          CommandParameter="{Binding}" ToolTip.Tip="Убрать персонажа">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="12" />
                                  </Button>
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="outlineButton" HorizontalAlignment="Left"
                                Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).AddParticipantCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Text="Добавить персонажа" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <TextBlock Classes="sectionCaps" Text="СЦЕНЫ ШАГА" Margin="0,4,0,0" />
                        <ItemsControl ItemsSource="{Binding Scenes}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="story:StepSceneLabel">
                              <Border Background="{DynamicResource SurfaceCardBrush}"
                                      BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                                      CornerRadius="14" Padding="12,6" Margin="0,0,8,6" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Label}" FontSize="12"
                                           Foreground="{DynamicResource SidebarTextBrush}" />
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Classes="muted" TextWrapping="Wrap"
                                   Text="Сцены шага назначаются на экране сцены: связь задаётся со стороны сцены."
                                   IsVisible="{Binding !HasScenes}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="muted" Text="{Binding StepHint}" Margin="52,2,0,14" TextWrapping="Wrap"
                   IsVisible="{Binding !HasSteps}" />

        <Button Classes="outlineButton" HorizontalAlignment="Left" Margin="52,0,0,0"
                Command="{Binding AddStepCommand}">
          <StackPanel Orientation="Horizontal" Spacing="9">
            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="Добавить шаг" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </StackPanel>
    </ScrollViewer>

    <!-- Правая колонка: свойства линии и краткая сводка выбранного шага. -->
    <Border Grid.Column="2"
            Background="{DynamicResource SurfaceCanvasBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="22,20,22,20">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
          <TextBlock Grid.Column="0" Classes="panelTitle" Text="Свойства линии" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding TogglePropertiesCommand}"
                  ToolTip.Tip="Свернуть свойства">
            <TextBlock Text="&#x25BE;" FontSize="12" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsPropertiesExpanded}">
          <StackPanel Spacing="16">
            <!-- Кратко о выбранном шаге (макет: сводка при выборе шага). -->
            <Border Background="{DynamicResource SurfaceCardBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                    CornerRadius="12" Padding="14" IsVisible="{Binding HasSelectedStep}">
              <StackPanel Spacing="7">
                <TextBlock Classes="sectionCaps" Text="{Binding SelectedStepNumberText}" />
                <TextBlock Text="{Binding SelectedStepHeading}" FontSize="16" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Classes="muted" Text="{Binding SelectedStepDescriptionText}" TextWrapping="Wrap" />
                <TextBlock Classes="sectionCaps" Text="ПЕРСОНАЖИ" Margin="0,4,0,0" />
                <TextBlock Classes="muted" Text="{Binding SelectedStepParticipantsText}" TextWrapping="Wrap" />
                <TextBlock Classes="sectionCaps" Text="СЦЕНЫ" Margin="0,4,0,0" />
                <TextBlock Classes="muted" Text="{Binding SelectedStepScenesText}" TextWrapping="Wrap" />
                <TextBlock Classes="muted" Text="{Binding SelectedStepFinalText}" />
              </StackPanel>
            </Border>

            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="Название" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Name, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="Цель" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Goal, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"
                       Watermark="Чего линия добивается в книге" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="Статус" />
              <ComboBox HorizontalAlignment="Stretch" MinHeight="46"
                        ItemsSource="{Binding StatusChoices}"
                        SelectedItem="{Binding StatusChoice, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="9">
              <TextBlock Classes="fieldLabel" Text="Цвет линии" />
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="story:LineSwatch">
                    <Button Classes="swatchButton"
                            Command="{Binding $parent[UserControl].((story:TimelineViewModel)DataContext).SetColorCommand}"
                            CommandParameter="{Binding Hex}"
                            ToolTip.Tip="{Binding Hex}">
                      <Border Classes="swatchRing" Classes.selected="{Binding IsSelected}">
                        <Ellipse Fill="{Binding Brush}" />
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="Заметки" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Notes, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110"
                       Watermark="Дополнительная информация о линии..." />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
          <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding SaveLineCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="Сохранить линию" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="dangerButton" HorizontalAlignment="Stretch"
                  Command="{Binding DeleteLineCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="Удалить линию" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
