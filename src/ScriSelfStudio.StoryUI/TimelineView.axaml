<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:story="clr-namespace:ScriSelfStudio.StoryUI"
             x:Class="ScriSelfStudio.StoryUI.TimelineView" x:Name="TimelineRoot"
             x:DataType="story:TimelineViewModel"
             Background="{DynamicResource SurfaceCanvasBrush}">
  <UserControl.Styles>
    <!-- Заголовки и подписи макета: заголовки панелей — антиква, как в остальном приложении. -->
    <Style Selector="TextBlock.panelTitle">
      <Setter Property="FontFamily" Value="{DynamicResource WorkspaceHeadingFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
    </Style>
    <Style Selector="TextBlock.lineHeading">
      <Setter Property="FontFamily" Value="{DynamicResource WorkspaceHeadingFont}" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionCaps">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
    </Style>
    <Style Selector="TextBlock.stepTitle">
      <Setter Property="FontFamily" Value="{DynamicResource WorkspaceHeadingFont}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource HeadingBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.stepText">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBox.fieldBox">
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.outlineButton">
      <Setter Property="Background" Value="{DynamicResource SurfaceFieldBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
    </Style>
    <Style Selector="Button.outlineButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.dangerButton">
      <Setter Property="Background" Value="{DynamicResource DangerFillBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.dangerButton:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.ghostIcon">
      <Setter Property="Width" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarSubTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ghostIcon:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="Button.outlinePlus">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.outlinePlus:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>

    <Style Selector="ListBox.linesList">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:pointerover">
      <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceSelectedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceSelectedBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <!-- У выбранного пункта разделитель не рисуется: его роль играет рамка макета. -->
    <Style Selector="ListBox.linesList > ListBoxItem:selected Rectangle.listSep">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ListBox.linesList TextBlock.lineName">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="ListBox.linesList > ListBoxItem:selected TextBlock.lineName">
      <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}" />
    </Style>

    <Style Selector="Border.timelineDot">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.iconChip">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.stepCard">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SurfaceBorderBrush}" />
      <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Button.stepHead">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="TabControl.stepTabs">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="TabControl.stepTabs TabItem">
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <Style Selector="Border.statusPill">
      <Setter Property="CornerRadius" Value="{DynamicResource WorkspacePanelRadius}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="Background" Value="{DynamicResource StatusActiveFillBrush}" />
    </Style>

    <Style Selector="Border.swatchRing">
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="CornerRadius" Value="{DynamicResource WorkspacePanelRadius}" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="Border.swatchRing.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource DangerTextBrush}" />
    </Style>
    <Style Selector="Button.swatchButton">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </UserControl.Styles>

  <Grid x:Name="TimelineWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="100" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="2.8*" MinWidth="220" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="1.2*" MinWidth="140" />
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="TimelineLeftSplitter" Grid.Column="1"
                    Classes="workspaceSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10"
                    AutomationProperties.Name="{loc:Tr 'Изменить ширину левой панели'}" ToolTip.Tip="{loc:Tr 'Изменить ширину левой панели'}" />
      <GridSplitter x:Name="TimelineRightSplitter" Grid.Column="3"
                    Classes="workspaceSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10"
                    AutomationProperties.Name="{loc:Tr 'Изменить ширину правой панели'}" ToolTip.Tip="{loc:Tr 'Изменить ширину правой панели'}" />
    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceCanvasBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="8,10,8,10">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Classes="panelTitle" Text="{loc:Tr 'Линии'}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="outlinePlus" Command="{Binding NewLineCommand}"
                  ToolTip.Tip="{loc:Tr 'Новая линия'}">
            <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE710;" />
          </Button>
        </Grid>
        <TextBlock DockPanel.Dock="Top" Classes="muted" Margin="2,0,0,6"
                   Text="{loc:Tr 'Пока пусто. Нажмите «+», чтобы создать линию.'}"
                   IsVisible="{Binding !HasPlotLines}" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ListBox Classes="linesList"
                   ItemsSource="{Binding PlotLines}"
                   SelectedItem="{Binding SelectedLine, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="story:PlotLineListItem">
                <Grid RowDefinitions="*,Auto">
                  <Grid Grid.Row="0" ColumnDefinitions="4,Auto,*,Auto" Margin="0,7,0,7">
                    <Border Grid.Column="0" Width="4" CornerRadius="12,0,0,12"
                            Background="{DynamicResource DangerTextBrush}"
                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}" />
                    <Ellipse Grid.Column="1" Width="9" Height="9" Fill="{Binding Swatch}"
                             VerticalAlignment="Top" Margin="8,4,0,0" />
                    <StackPanel Grid.Column="2" Margin="8,0,4,0" Spacing="2">
                      <TextBlock Classes="lineName" Text="{Binding Name}" />
                      <TextBlock Classes="muted" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="3" Classes="ghostIcon" VerticalAlignment="Top"
                            Margin="0,0,0,0" ToolTip.Tip="{loc:Tr 'Действия'}">
                      <TextBlock Text="•••" FontSize="11" />
                      <Button.Flyout>
                        <MenuFlyout>
                          <MenuItem Header="{loc:Tr 'Поднять выше'}"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).MoveLineUpCommand}"
                                    CommandParameter="{Binding Id}" />
                          <MenuItem Header="{loc:Tr 'Опустить ниже'}"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).MoveLineDownCommand}"
                                    CommandParameter="{Binding Id}" />
                          <MenuItem Header="{loc:Tr 'Переименовать'}"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).ToggleHeaderEditingCommand}" />
                          <MenuItem Header="{loc:Tr 'Удалить линию'}"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).DeleteLineByIdCommand}"
                                    CommandParameter="{Binding Id}" />
                        </MenuFlyout>
                      </Button.Flyout>
                    </Button>
                  </Grid>
                  <Rectangle Grid.Row="1" Classes="listSep" Height="1" Margin="14,0,14,0"
                             Fill="{DynamicResource SurfaceBorderBrush}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Центр: шапка линии и лента шагов (макет: крупный заголовок, «Шаги»). -->
    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="22,14,14,16" Spacing="0">
        <TextBlock Classes="error" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Classes="success" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}"
                   TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock Classes="muted" Margin="0,0,0,10"
                   Text="{loc:Tr 'Проект не открыт. Вернитесь на стартовый экран.'}"
                   IsVisible="{Binding !HasProject}" />

        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="0,0,0,12">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Ellipse Width="10" Height="10" Fill="{Binding LineBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LineTitle}" FontSize="13" VerticalAlignment="Center"
                       TextDecorations="Underline"
                       Foreground="{DynamicResource SidebarSubTextBrush}" />
          </StackPanel>
          <Border Grid.Row="0" Grid.Column="1" Classes="statusPill">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Ellipse Width="10" Height="10" Fill="{Binding StatusDot}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding StatusLabel}" FontSize="12" VerticalAlignment="Center"
                         Foreground="{DynamicResource StatusActiveTextBrush}" />
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1" Grid.Column="0" Classes="lineHeading" Text="{Binding LineHeading}"
                     Margin="0,4,16,0" />
          <Button Grid.Row="1" Grid.Column="1" Classes="outlineButton" VerticalAlignment="Top" Margin="0,4,0,0"
                  Command="{Binding ToggleHeaderEditingCommand}"
                  IsVisible="{Binding !IsHeaderEditing}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE70F;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Изменить'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Grid.Row="1" Grid.Column="1" Classes="outlineButton" VerticalAlignment="Top" Margin="0,4,0,0"
                  Command="{Binding CommitLineCommand}"
                  IsVisible="{Binding IsHeaderEditing}">
            <StackPanel Orientation="Horizontal" Spacing="9">
              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE73E;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Готово'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>

          <TextBox Grid.Row="2" Grid.ColumnSpan="2" Classes="fieldBox" Margin="0,10,0,0"
                   Text="{Binding Draft.Description, Mode=TwoWay}"
                   PlaceholderText="{loc:Tr 'Рабочее название линии'}"
                   IsVisible="{Binding IsHeaderEditing}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding GoalText}" FontSize="12" Margin="0,6,16,0"
                     Foreground="{DynamicResource SidebarSubTextBrush}" TextWrapping="Wrap"
                     IsVisible="{Binding !IsHeaderEditing}" />
        </Grid>

        <Border Height="1" Background="{DynamicResource SurfaceBorderBrush}" Margin="0,0,0,12" />

        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE8FD;" FontSize="15" VerticalAlignment="Center"
                       Foreground="{DynamicResource SidebarTextBrush}" />
            <TextBlock Text="{loc:Tr 'Шаги'}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource HeadingBrush}" />
          </StackPanel>
          <Button Grid.Column="1" Classes="outlineButton" MinHeight="32" Padding="10,0"
                  Command="{Binding AddStepCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Добавить шаг'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>

        <ItemsControl ItemsSource="{Binding Draft.Steps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="story:StepDraft">
              <Grid ColumnDefinitions="40,*" Margin="0,0,0,8">
                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                  <Border Classes="timelineDot" Background="{Binding AccentBrush}">
                    <TextBlock Text="{Binding NumberText}" FontSize="13" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <Grid Grid.Row="1" IsVisible="{Binding ShowConnector}" MinHeight="16">
                    <Rectangle Width="1.5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                               Fill="{DynamicResource SurfaceBorderBrush}" />
                    <TextBlock Text="&#x25BE;" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                               Foreground="{DynamicResource SidebarSubTextBrush}" />
                  </Grid>
                </Grid>

                <Border Grid.Column="1" Classes="stepCard" Background="{Binding FillBrush}">
                  <Grid ColumnDefinitions="6,*">
                    <Rectangle Grid.Column="0" Fill="{Binding AccentBrush}" />
                    <StackPanel Grid.Column="1" Spacing="0">
                      <Grid ColumnDefinitions="*,Auto">
                        <Button Grid.Column="0" Classes="stepHead"
                                Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).ToggleStepCommand}"
                                CommandParameter="{Binding}"
                                ToolTip.Tip="{loc:Tr 'Раскрыть или свернуть шаг'}">
                          <Grid ColumnDefinitions="Auto,*" Margin="10,8,6,8">
                            <Border Grid.Column="0" Classes="iconChip">
                              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="{Binding IconGlyph}" FontSize="17"
                                         Foreground="{Binding AccentBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3" VerticalAlignment="Center">
                              <TextBlock Classes="stepTitle" Text="{Binding Header}" />
                              <TextBlock Classes="stepText" Text="{Binding Description}"
                                         IsVisible="{Binding HasDescription}" />
                            </StackPanel>
                          </Grid>
                        </Button>
                        <Button Grid.Column="1" Classes="ghostIcon" Margin="0,12,12,0" VerticalAlignment="Top"
                                ToolTip.Tip="{loc:Tr 'Действия шага'}">
                          <TextBlock Text="•••" FontSize="11" />
                          <Button.Flyout>
                            <MenuFlyout>
                              <MenuItem Header="{loc:Tr 'Выше'}"
                                        Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).MoveStepUpCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="{loc:Tr 'Ниже'}"
                                        Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).MoveStepDownCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="{loc:Tr 'Финальный шаг'}"
                                        Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).ToggleFinalCommand}"
                                        CommandParameter="{Binding}" />
                              <MenuItem Header="{loc:Tr 'Удалить шаг'}"
                                        Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).RemoveStepCommand}"
                                        CommandParameter="{Binding}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>

                      <TabControl Classes="stepTabs" Margin="12,0,12,12" IsVisible="{Binding IsExpanded}"
                                  SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                  Background="Transparent" BorderThickness="0">
                        <TabItem Header="{loc:Tr 'Основное'}">
                          <StackPanel Margin="8,10,8,4" Spacing="8">
                            <Grid ColumnDefinitions="*,150" ColumnSpacing="12">
                              <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Classes="sectionCaps" Text="{loc:Tr 'НАЗВАНИЕ ШАГА'}" />
                                <TextBox Classes="fieldBox" Text="{Binding Title, Mode=TwoWay}" />
                              </StackPanel>
                              <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="sectionCaps" Text="{loc:Tr 'ЗНАЧОК'}" />
                                <ComboBox HorizontalAlignment="Stretch" MinHeight="34"
                                          ItemsSource="{Binding IconChoices}"
                                          SelectedItem="{Binding SelectedIcon, Mode=TwoWay}" />
                              </StackPanel>
                            </Grid>
                            <TextBlock Classes="sectionCaps" Text="{loc:Tr 'ОПИСАНИЕ'}" />
                            <TextBox Classes="fieldBox" Text="{Binding Description, Mode=TwoWay}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" />
                            <Button Classes="outlineButton" HorizontalAlignment="Left" MinHeight="30"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).ToggleFinalCommand}"
                                    CommandParameter="{Binding}">
                              <TextBlock Text="{loc:Tr 'Переключить финальный шаг'}" />
                            </Button>
                          </StackPanel>
                        </TabItem>
                        <TabItem Header="{loc:Tr 'Персонажи'}">
                          <StackPanel Margin="8,10,8,4" Spacing="8">
                            <ItemsControl ItemsSource="{Binding Participants}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="story:StepParticipantDraft">
                                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,6">
                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="34"
                                              ItemsSource="{Binding Characters}"
                                              SelectedItem="{Binding Character, Mode=TwoWay}" />
                                    <Button Grid.Column="1" Classes="ghostIcon"
                                            Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).RemoveParticipantCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="{loc:Tr 'Убрать персонажа'}">
                                      <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE711;" FontSize="12" />
                                    </Button>
                                  </Grid>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="outlineButton" HorizontalAlignment="Left" MinHeight="30"
                                    Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).AddParticipantCommand}">
                              <TextBlock Text="{loc:Tr '+ Добавить персонажа'}" />
                            </Button>
                          </StackPanel>
                        </TabItem>
                        <TabItem Header="{loc:Tr 'Арки'}">
                          <StackPanel Margin="8,10,8,4" Spacing="8">
                            <ItemsControl ItemsSource="{Binding Participants}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="story:StepParticipantDraft">
                                  <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <TextBlock Classes="sectionCaps" Text="{Binding Character.Name}" />
                                    <ComboBox HorizontalAlignment="Stretch" MinHeight="34"
                                              ItemsSource="{Binding AvailableSteps}"
                                              SelectedItem="{Binding ArcStage, Mode=TwoWay}"
                                              PlaceholderText="{loc:Tr 'Выберите этап арки'}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" Text="{loc:Tr 'Сначала добавьте персонажа на вкладке «Персонажи».'}"
                                       IsVisible="{Binding !HasParticipants}" TextWrapping="Wrap" />
                          </StackPanel>
                        </TabItem>
                        <TabItem Header="{loc:Tr 'Сцены'}">
                          <StackPanel Margin="8,10,8,4" Spacing="8">
                            <ItemsControl ItemsSource="{Binding Scenes}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="story:StepSceneLabel">
                                  <Border Background="{DynamicResource SurfaceFieldBrush}"
                                          BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                                          CornerRadius="7" Padding="8,5" Margin="0,0,0,5"
                                          HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               Foreground="{DynamicResource SidebarTextBrush}" />
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="muted" TextWrapping="Wrap"
                                       Text="{loc:Tr 'Связать сцену с этим шагом можно из редактора сцены.'}"
                                       IsVisible="{Binding !HasScenes}" />
                          </StackPanel>
                        </TabItem>
                      </TabControl>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="muted" Text="{Binding StepHint}" Margin="52,2,0,14" TextWrapping="Wrap"
                   IsVisible="{Binding !HasSteps}" />

      </StackPanel>
    </ScrollViewer>

    <!-- Правая колонка: свойства линии и краткая сводка выбранного шага. -->
    <Border Grid.Column="4"
            Background="{DynamicResource SurfaceCanvasBrush}"
            BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*,Auto" Margin="14,14,14,14">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
          <TextBlock Grid.Column="0" Classes="panelTitle" Text="{loc:Tr 'Свойства линии'}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="ghostIcon" Command="{Binding TogglePropertiesCommand}"
                  ToolTip.Tip="{loc:Tr 'Свернуть свойства'}">
            <TextBlock Text="&#x25BE;" FontSize="12" />
          </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                      IsVisible="{Binding IsPropertiesExpanded}">
          <StackPanel Spacing="9">
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="{loc:Tr 'Название'}" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Name, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="{loc:Tr 'Цель'}" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Goal, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56"
                       PlaceholderText="{loc:Tr 'Чего линия добивается в книге'}" />
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="{loc:Tr 'Статус'}" />
              <ComboBox HorizontalAlignment="Stretch" MinHeight="34"
                        ItemsSource="{Binding StatusChoices}"
                        SelectedItem="{Binding StatusChoice, Mode=TwoWay}" />
            </StackPanel>
            <StackPanel Spacing="9">
              <TextBlock Classes="fieldLabel" Text="{loc:Tr 'Цвет линии'}" />
              <ItemsControl ItemsSource="{Binding Swatches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="story:LineSwatch">
                    <Button Classes="swatchButton"
                            Command="{Binding #TimelineRoot.((story:TimelineViewModel)DataContext).SetColorCommand}"
                            CommandParameter="{Binding Hex}"
                            ToolTip.Tip="{Binding Hex}">
                      <Border Classes="swatchRing" Classes.selected="{Binding IsSelected}">
                        <Ellipse Fill="{Binding Brush}" />
                      </Border>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            <StackPanel Spacing="7">
              <TextBlock Classes="fieldLabel" Text="{loc:Tr 'Заметки'}" />
              <TextBox Classes="fieldBox" Text="{Binding Draft.Notes, Mode=TwoWay}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                       PlaceholderText="{loc:Tr 'Дополнительная информация о линии...'}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Spacing="7" Margin="0,10,0,0">
          <Button Classes="accentBtn" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding SaveLineCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE74E;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Сохранить линию'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Classes="dangerButton" HorizontalAlignment="Stretch"
                  Command="{Binding DeleteLineCommand}">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
              <TextBlock FontFamily="{StaticResource SymbolsFontFamily}" Text="&#xE74D;" FontSize="13" VerticalAlignment="Center" />
              <TextBlock Text="{loc:Tr 'Удалить линию'}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
