<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:launcher="clr-namespace:ScriSelfStudio.Launcher"
             x:Class="ScriSelfStudio.Launcher.SettingsView"
             x:DataType="launcher:SettingsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="{DynamicResource WorkspaceOuterMargin}" Container.Name="settingsWorkspace" Container.Sizing="Width">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <Button Command="{Binding GoBackCommand}" Content="{loc:Tr '← Назад'}" Padding="12,6" CornerRadius="8" />
        <TextBlock Text="{loc:Tr '⚙ Настройки'}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBox Grid.Column="2" Text="{Binding SearchQuery, Mode=TwoWay}"
               PlaceholderText="{loc:Tr '🔍 Поиск настроек...'}" Width="240" Height="34"
               CornerRadius="8" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" x:Name="SettingsWorkspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*" MinWidth="120" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="2.7*" MinWidth="220" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="1.5*" MinWidth="160" />
      </Grid.ColumnDefinitions>
      <GridSplitter x:Name="SettingsLeftSplitter" Grid.Column="1"
                    Classes="workspaceSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10"
                    AutomationProperties.Name="{loc:Tr 'Изменить ширину левой панели'}" ToolTip.Tip="{loc:Tr 'Изменить ширину левой панели'}" />
      <GridSplitter x:Name="SettingsRightSplitter" Grid.Column="3"
                    Classes="workspaceSplitter" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" KeyboardIncrement="10"
                    AutomationProperties.Name="{loc:Tr 'Изменить ширину правой панели'}" ToolTip.Tip="{loc:Tr 'Изменить ширину правой панели'}" />
      <Border Grid.Column="0" Classes="settingsSections" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource WorkspacePanelRadius}" Padding="8" Margin="0,0,16,0">
        <ListBox ItemsSource="{Binding VisibleSections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border CornerRadius="8" Padding="12,10" Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </Border>
                </ControlTemplate>
              </Setter>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="launcher:SettingsSectionOption">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="11"
                           Foreground="{DynamicResource SidebarSubTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource WorkspacePanelRadius}" Padding="24" Margin="0,0,16,0">
          <StackPanel Spacing="20">
            <StackPanel>
              <TextBlock Text="{Binding SelectedSectionTitle}" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <TextBlock Text="{loc:Tr 'Изменения применяются автоматически и сохраняются.'}"
                         FontSize="13" Foreground="{DynamicResource SidebarSubTextBrush}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <Border IsVisible="{Binding HasError}" Background="#FEE2E2" BorderBrush="#EF4444"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" />
            </Border>
            <Border IsVisible="{Binding HasStatus}" Background="#ECFDF5" BorderBrush="#10B981"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" />
            </Border>

            <StackPanel IsVisible="{Binding IsGeneralSection}" Spacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr 'Язык интерфейса'}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="launcher:LanguageOption">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Tr 'Язык применяется сразу ко всему интерфейсу.'}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr 'При запуске'}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <CheckBox Content="{loc:Tr 'Открывать последний проект автоматически'}"
                          IsChecked="{Binding OpenLastProjectOnStartup}" />
                <CheckBox Content="{loc:Tr 'Спрашивать о восстановлении проекта'}"
                          IsChecked="{Binding CheckRecoveryOnStartup}" />
                <CheckBox Content="{loc:Tr 'Проверять обновления на сайте при запуске'}"
                          IsChecked="{Binding CheckForUpdatesOnStartup}" />
                <CheckBox Content="{loc:Tr 'Отправлять статистику использования'}"
                          IsChecked="{Binding ShareUsageStatistics}" />
                <TextBlock Text="{loc:Tr 'Раз в день: случайный номер установки, версия и платформа. Без имён, проектов и текста. Получатель — scriself.com. Можно отключить в любой момент.'}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{loc:Tr 'Если проверка восстановления выключена, снимок восстановления останется на диске.'}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAppearanceSection}" Spacing="12">
              <TextBlock Text="{loc:Tr 'Тема оформления'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <ComboBox x:Name="ThemeChoice" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr 'Тема оформления'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="launcher:ThemeOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding ThemeDescription}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{loc:Tr 'Переключение разделов'}" FontWeight="SemiBold" Margin="0,8,0,0" />
              <ComboBox x:Name="NavigationChoice" ItemsSource="{Binding NavigationOptions}"
                        IsEnabled="{Binding IsClassicNavigationAvailable}"
                        SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr 'Переключение разделов'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="launcher:NavigationOption"><TextBlock Text="{Binding Title}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{Binding NavigationDescription}"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsEditorSection}" Spacing="14">
              <TextBlock Text="{loc:Tr 'Проверка и набор текста'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource HeadingBrush}" />
              <CheckBox Content="{loc:Tr 'Проверять орфографию: русский и английский'}" IsChecked="{Binding SpellCheckEnabled}" />
              <CheckBox Name="GrammarSettingsToggle" Content="{loc:Tr 'Грамматические подсказки LanguageTool на компьютере'}" IsChecked="{Binding GrammarCheckEnabled}" />
              <ComboBox Name="GrammarLanguageBox" ItemsSource="{Binding GrammarLanguages}" SelectedItem="{Binding SelectedGrammarLanguage}"
                        HorizontalAlignment="Stretch" AutomationProperties.Name="{loc:Tr 'Язык грамматической проверки'}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="launcher:LanguageOption"><TextBlock Text="{Binding Title}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Text="{loc:Tr 'Находит часть ошибок грамматики и пунктуации. Некоторые русские запятые пропускает; исправления выбираете вы. Текст не отправляется в интернет.'}"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
              <CheckBox Name="AutoCapitalizationToggle" Content="{loc:Tr 'Заглавная буква после точки'}" IsChecked="{Binding AutoCapitalizeSentences}" />
              <TextBlock Text="{loc:Tr 'После «. слово» нажмите пробел — получится «. Слово ». Ручная строчная буква и отмена сохраняются. Вставленный текст не меняется.'}"
                         TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
              <TextBlock Text="{loc:Tr 'Шрифт текста в редакторе'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                        IsEnabled="{Binding CanEditProjectSettings}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="launcher:FontOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding FontSizeLabel}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                <NumericUpDown Value="{Binding FontSize}" Minimum="{Binding MinFontSize}"
                               Maximum="{Binding MaxFontSize}" IsEnabled="{Binding CanEditProjectSettings}"
                               HorizontalAlignment="Stretch" />
              </StackPanel>
              <TextBlock IsVisible="{Binding !CanEditProjectSettings}"
                         Text="{loc:Tr 'Откройте проект, чтобы изменить шрифт и размер текста.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSavingSection}" Spacing="14">
              <TextBlock Text="{loc:Tr 'Автосохранение проекта'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <CheckBox Content="{loc:Tr 'Включить автосохранение'}"
                        IsChecked="{Binding AutoSaveEnabled}"
                        IsEnabled="{Binding CanEditProjectSettings}" />
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding AutoSaveIntervalLabel}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                <NumericUpDown Value="{Binding AutoSaveIntervalSeconds}"
                               Minimum="{Binding MinAutoSaveIntervalSeconds}"
                               Maximum="{Binding MaxAutoSaveIntervalSeconds}"
                               IsEnabled="{Binding CanEditAutoSaveInterval}"
                               HorizontalAlignment="Stretch" />
              </StackPanel>
              <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />
              <CheckBox Content="{loc:Tr 'Создавать резервную копию при сохранении'}"
                        IsChecked="{Binding BackupsEnabled}"
                        IsEnabled="{Binding CanEditProjectSettings}" />
              <TextBlock Text="{loc:Tr 'При следующем обычном сохранении будет перезаписан файл .bak проекта.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding !CanEditProjectSettings}"
                         Text="{loc:Tr 'Откройте проект, чтобы настроить автосохранение и резервные копии.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock IsVisible="{Binding !HasVisibleSections}"
                       Text="{loc:Tr 'По запросу ничего не найдено.'}" Foreground="{DynamicResource SidebarSubTextBrush}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <ScrollViewer Grid.Column="4" Classes="settingsPreview" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource WorkspacePanelRadius}" Padding="20">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr 'Предпросмотр'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <TextBlock Text="{Binding SelectedTheme.Title}" FontSize="12"
                         Foreground="{DynamicResource SidebarSubTextBrush}" />
            </StackPanel>
            <Border Background="{DynamicResource SurfaceCanvasBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource SurfaceChromeBrush}" CornerRadius="6" Padding="8">
                  <TextBlock Text="ScriSelf Studio" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource HeadingBrush}" />
                </Border>
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Текст рукописи'}" FontWeight="Bold"
                               FontFamily="{Binding PreviewFontFamily}"
                               Foreground="{DynamicResource HeadingBrush}" />
                    <TextBlock Text="{loc:Tr 'Выбранный шрифт применяется к тексту открытого проекта.'}"
                               FontFamily="{Binding PreviewFontFamily}"
                               Foreground="{DynamicResource SidebarTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="{loc:Tr 'Шрифт и размер настраиваются отдельно для каждого проекта.'}"
                       FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
