<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ScriSelfStudio.Presentation.Localization;assembly=ScriSelfStudio.Presentation"
             xmlns:launcher="clr-namespace:ScriSelfStudio.Launcher"
             x:Class="ScriSelfStudio.Launcher.SettingsView"
             x:DataType="launcher:SettingsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="24">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
        <Button Command="{Binding GoBackCommand}" Content="{loc:Tr '← Назад'}" Padding="12,6" CornerRadius="8" />
        <TextBlock Text="{loc:Tr '⚙ Настройки'}" FontSize="22" FontWeight="Bold"
                   Foreground="{DynamicResource HeadingBrush}" VerticalAlignment="Center" />
      </StackPanel>
      <TextBox Grid.Column="2" Text="{Binding SearchQuery, Mode=TwoWay}"
               PlaceholderText="{loc:Tr '🔍 Поиск настроек...'}" Width="240" Height="34"
               CornerRadius="8" VerticalAlignment="Center" />
    </Grid>

    <Grid Grid.Row="1" ColumnDefinitions="220,*,340">
      <Border Grid.Column="0" Background="{DynamicResource SurfaceCardBrush}"
              BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
              CornerRadius="14" Padding="8" Margin="0,0,16,0">
        <ListBox ItemsSource="{Binding VisibleSections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0">
          <ListBox.ItemContainerTheme>
            <ControlTheme TargetType="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,2" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
              <Setter Property="Template">
                <ControlTemplate>
                  <Border CornerRadius="8" Padding="12,10" Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                  </Border>
                </ControlTemplate>
              </Setter>
            </ControlTheme>
          </ListBox.ItemContainerTheme>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="launcher:SettingsSectionOption">
              <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <TextBlock Text="{Binding Description}" FontSize="11"
                           Foreground="{DynamicResource SidebarSubTextBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="24" Margin="0,0,16,0">
          <StackPanel Spacing="20">
            <StackPanel>
              <TextBlock Text="{Binding SelectedSection.Title}" FontSize="20" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <TextBlock Text="{loc:Tr 'Изменения применяются автоматически и сохраняются.'}"
                         FontSize="13" Foreground="{DynamicResource SidebarSubTextBrush}"
                         Margin="0,2,0,0" />
            </StackPanel>

            <Border IsVisible="{Binding HasError}" Background="#FEE2E2" BorderBrush="#EF4444"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#991B1B" TextWrapping="Wrap" />
            </Border>
            <Border IsVisible="{Binding HasStatus}" Background="#ECFDF5" BorderBrush="#10B981"
                    BorderThickness="1" CornerRadius="6" Padding="12">
              <TextBlock Text="{Binding StatusMessage}" Foreground="#065F46" TextWrapping="Wrap" />
            </Border>

            <StackPanel IsVisible="{Binding IsGeneralSection}" Spacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{loc:Tr 'Региональный формат'}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                          HorizontalAlignment="Stretch">
                  <ComboBox.ItemTemplate>
                    <DataTemplate DataType="launcher:LanguageOption">
                      <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{loc:Tr 'Язык применяется сразу ко всему интерфейсу.'}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />

              <StackPanel Spacing="8">
                <TextBlock Text="{loc:Tr 'При запуске'}" FontSize="14" FontWeight="Bold"
                           Foreground="{DynamicResource HeadingBrush}" />
                <CheckBox Content="{loc:Tr 'Открывать последний проект автоматически'}"
                          IsChecked="{Binding OpenLastProjectOnStartup}" />
                <CheckBox Content="{loc:Tr 'Спрашивать о восстановлении проекта'}"
                          IsChecked="{Binding CheckRecoveryOnStartup}" />
                <CheckBox Content="{loc:Tr 'Проверять обновления на сайте при запуске'}"
                          IsChecked="{Binding CheckForUpdatesOnStartup}" />
                <TextBlock Text="{loc:Tr 'Если проверка восстановления выключена, снимок восстановления останется на диске.'}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>

            <StackPanel IsVisible="{Binding IsAppearanceSection}" Spacing="12">
              <TextBlock Text="{loc:Tr 'Тема оформления'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <Border Background="{DynamicResource SurfaceFieldBrush}"
                      BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                      CornerRadius="8" Padding="12,9">
                <TextBlock Text="{Binding SelectedTheme.Title}" />
              </Border>
              <TextBlock Text="{loc:Tr 'Выбор тем временно недоступен: приложение использует стандартную тему.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsEditorSection}" Spacing="14">
              <TextBlock Text="{loc:Tr 'Шрифт текста в редакторе'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <ComboBox ItemsSource="{Binding Fonts}" SelectedItem="{Binding SelectedFont}"
                        IsEnabled="{Binding CanEditProjectSettings}" HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate DataType="launcher:FontOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding FontSizeLabel}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                <NumericUpDown Value="{Binding FontSize}" Minimum="{Binding MinFontSize}"
                               Maximum="{Binding MaxFontSize}" IsEnabled="{Binding CanEditProjectSettings}"
                               HorizontalAlignment="Stretch" />
              </StackPanel>
              <TextBlock IsVisible="{Binding !CanEditProjectSettings}"
                         Text="{loc:Tr 'Откройте проект, чтобы изменить шрифт и размер текста.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsSavingSection}" Spacing="14">
              <TextBlock Text="{loc:Tr 'Автосохранение проекта'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <CheckBox Content="{loc:Tr 'Включить автосохранение'}"
                        IsChecked="{Binding AutoSaveEnabled}"
                        IsEnabled="{Binding CanEditProjectSettings}" />
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding AutoSaveIntervalLabel}"
                           FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}" />
                <NumericUpDown Value="{Binding AutoSaveIntervalSeconds}"
                               Minimum="{Binding MinAutoSaveIntervalSeconds}"
                               Maximum="{Binding MaxAutoSaveIntervalSeconds}"
                               IsEnabled="{Binding CanEditAutoSaveInterval}"
                               HorizontalAlignment="Stretch" />
              </StackPanel>
              <Rectangle Height="1" Fill="{DynamicResource SurfaceBorderBrush}" />
              <CheckBox Content="{loc:Tr 'Создавать резервную копию при сохранении'}"
                        IsChecked="{Binding BackupsEnabled}"
                        IsEnabled="{Binding CanEditProjectSettings}" />
              <TextBlock Text="{loc:Tr 'При следующем обычном сохранении будет перезаписан файл .bak проекта.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
              <TextBlock IsVisible="{Binding !CanEditProjectSettings}"
                         Text="{loc:Tr 'Откройте проект, чтобы настроить автосохранение и резервные копии.'}"
                         FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock IsVisible="{Binding !HasVisibleSections}"
                       Text="{loc:Tr 'По запросу ничего не найдено.'}" Foreground="{DynamicResource SidebarSubTextBrush}" />
          </StackPanel>
        </Border>
      </ScrollViewer>

      <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <Border Background="{DynamicResource SurfaceCardBrush}"
                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                CornerRadius="14" Padding="20">
          <StackPanel Spacing="16">
            <StackPanel Spacing="4">
              <TextBlock Text="{loc:Tr 'Предпросмотр'}" FontSize="14" FontWeight="Bold"
                         Foreground="{DynamicResource HeadingBrush}" />
              <TextBlock Text="{Binding SelectedTheme.Title}" FontSize="12"
                         Foreground="{DynamicResource SidebarSubTextBrush}" />
            </StackPanel>
            <Border Background="{DynamicResource SurfaceCanvasBrush}"
                    BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="12">
              <StackPanel Spacing="10">
                <Border Background="{DynamicResource SurfaceChromeBrush}" CornerRadius="6" Padding="8">
                  <TextBlock Text="ScriSelf Studio" FontSize="12" FontWeight="SemiBold"
                             Foreground="{DynamicResource HeadingBrush}" />
                </Border>
                <Border Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{loc:Tr 'Текст рукописи'}" FontWeight="Bold"
                               FontFamily="{Binding SelectedFont.Value}"
                               Foreground="{DynamicResource HeadingBrush}" />
                    <TextBlock Text="{loc:Tr 'Выбранный шрифт применяется к тексту открытого проекта.'}"
                               FontFamily="{Binding SelectedFont.Value}"
                               Foreground="{DynamicResource SidebarTextBrush}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <TextBlock Text="{loc:Tr 'Шрифт и размер настраиваются отдельно для каждого проекта.'}"
                       FontSize="12" Foreground="{DynamicResource SidebarSubTextBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
